+#[cfg(target_os = "veda")]
+pub fn current_exe() -> io::Result<PathBuf> {
+    // The loader gives a program the path of its file (`AT_EXECFN`), which
+    // is empty when whoever started it did not say.
+    let execfn = unsafe { libc::getauxval(libc::AT_EXECFN) } as usize;
+    let path = ptr::with_exposed_provenance::<c_char>(execfn);
+    let bytes = if path.is_null() { &[][..] } else { unsafe { CStr::from_ptr(path) }.to_bytes() };
+    if bytes.is_empty() {
+        return Err(io::const_error!(io::ErrorKind::Uncategorized, "the program's path is unknown"));
+    }
+    Ok(PathBuf::from(OsStr::from_bytes(bytes)))
+}
