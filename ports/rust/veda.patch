+use crate::spec::{Env, Os, TargetOptions, cvs};
+
+/// Veda: its C library is musl, and every program is linked statically,
+/// position-independent by default (`-static-pie`), by the driver of the C
+/// toolchain (`<arch>-veda-gcc`), which brings Veda's start files, its C
+/// library and GCC's runtime and unwinder, as for C programs.
+pub(crate) fn opts() -> TargetOptions {
+    TargetOptions {
+        os: Os::Veda,
+        env: Env::Musl,
+        families: cvs!["unix"],
+        // There are no shared libraries.
+        dynamic_linking: false,
+        crt_static_default: true,
+        crt_static_respected: true,
+        position_independent_executables: true,
+        static_position_independent_executables: true,
+        has_thread_local: true,
+        // Backtraces rely on unwind tables, whatever the panic strategy.
+        default_uwtable: true,
+        ..Default::default()
+    }
+}
