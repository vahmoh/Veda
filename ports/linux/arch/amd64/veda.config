# Linux for Veda's driver VM on AMD64 (x86-64): the options of x86's and of
# the devices only PCs have, beside every architecture's
# (ports/linux/veda.config). The platform's processors have an x2APIC.
CONFIG_64BIT=y
CONFIG_X86_X2APIC=y
CONFIG_HYPERVISOR_GUEST=y
CONFIG_VEDA_GUEST=y
# Write-combining mappings, which device drivers ask for.
CONFIG_MTRR=y
CONFIG_X86_PAT=y
CONFIG_X86_UMIP=y

# The kernel, unpacked quickly; at the address it was built for; with the
# built-in command line (CONFIG_CMDLINE).
CONFIG_KERNEL_ZSTD=y
CONFIG_RANDOMIZE_BASE=n
CONFIG_CMDLINE_BOOL=y

# A laptop's I2C and SPI controllers: Intel's LPSS ones. What makes the
# devices of an ACPI node that holds several (a laptop's amplifiers) is
# among x86's platform drivers.
CONFIG_MFD_INTEL_LPSS_PCI=y
CONFIG_SPI_PXA2XX=y
CONFIG_X86_PLATFORM_DEVICES=y
CONFIG_SERIAL_MULTI_INSTANTIATE=y

# The PC's keyboard controller, when Veda gives it (the ACPI tables
# describe it, as Plug and Play devices): PS/2 keyboards and mice,
# touchpads among them (Synaptics', ALPS', Elantech's protocols...).
CONFIG_PNP=y
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y
CONFIG_SERIO_LIBPS2=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_INPUT_MOUSE=y
CONFIG_MOUSE_PS2=y
CONFIG_MOUSE_PS2_ALPS=y
CONFIG_MOUSE_PS2_BYD=y
CONFIG_MOUSE_PS2_LOGIPS2PP=y
CONFIG_MOUSE_PS2_SYNAPTICS=y
CONFIG_MOUSE_PS2_CYPRESS=y
CONFIG_MOUSE_PS2_TRACKPOINT=y
CONFIG_MOUSE_PS2_ELANTECH=y
CONFIG_MOUSE_PS2_FOCALTECH=y

# Intel's integrated GPUs (i915).
CONFIG_DRM_I915=y
# What the GPU was doing when it hung (/sys/class/drm/card*/error).
CONFIG_DRM_I915_CAPTURE_ERROR=y

# The audio DSP of Intel's PCs, where the firmware's NHLT says it has
# digital microphones: Sound Open Firmware on it (from Tiger Lake to Raptor
# Lake: one driver's parts, each with its firmware in firmware.txt), its
# link to the HD Audio codecs, and the machine driver of a DSP with a codec
# and microphones. The HDMI codecs' driver comes with it.
CONFIG_SND_SOC_SOF_TOPLEVEL=y
CONFIG_SND_SOC_SOF_PCI=y
CONFIG_SND_SOC_SOF_INTEL_TOPLEVEL=y
CONFIG_SND_SOC_SOF_TIGERLAKE=y
CONFIG_SND_SOC_SOF_ELKHARTLAKE=y
CONFIG_SND_SOC_SOF_ALDERLAKE=y
CONFIG_SND_SOC_SOF_HDA_LINK=y
CONFIG_SND_SOC_SOF_HDA_AUDIO_CODEC=y
CONFIG_SND_SOC_INTEL_MACH=y
CONFIG_SND_SOC_INTEL_SKL_HDA_DSP_GENERIC_MACH=y
CONFIG_SND_HDA_CODEC_HDMI=y
CONFIG_SND_HDA_CODEC_HDMI_INTEL=y

# Nothing of x86's the platform lacks, nor its mitigations of processors'
# vulnerabilities (the guest runs only Veda's programs).
CONFIG_ISA_DMA_API=n
CONFIG_IA32_EMULATION=n
CONFIG_X86_16BIT=n
CONFIG_X86_VSYSCALL_EMULATION=n
CONFIG_CPU_MITIGATIONS=n
