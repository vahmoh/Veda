# Interceptor's picture in the README: a chase at sunset on a road through
# the trees of the hills, full screen in Full HD. Regenerate it with
#
#   cargo xtask script docs/interceptor.vts --resolution 1920x1080
#
# which writes docs/images/interceptor.png. The game starts with the
# system; F3 twice turns the statistics off, and a quick chase at sunset is
# chosen from the menus (its menu opens on its start button; four up is the
# time of day, one left from night is sunset). The computer takes the wheel
# during the countdown, so every run films the same chase: 9 s on, the
# police car among the traffic between the trees, the sun low.
boot-cmdline "run=interceptor"
fail-on "PANIC"
fail-on "rendering stops"
wait-serial "interceptor: ready" 120
wait 2
key f3
wait 1
key f3
wait 1
key ret
wait-serial "screen Main" 10
key down
key ret
wait-serial "screen Quick" 10
key up
key up
key up
key up
key left
key down
key down
key down
key down
key ret
wait-serial "screen Playing" 10
key f8
wait-serial "autopilot on" 10
wait 9
shot docs/images/interceptor.png
