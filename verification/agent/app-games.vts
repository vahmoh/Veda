# Interceptor and About for the voice agent, with a simulated Voice Agent
# service. A game whose window is not in front waits, paused: a chase the
# agent started pauses itself when the Terminal takes the keyboard, the
# agent cannot resume it until it brings its window to the front, and then
# it goes on (the computer drives, F8). About shows its licences.
fail-on "PANIC"
wait-serial "desktop ready" 120
mic-silence 1
agent-connected 120
wait-serial "state: Listening" 30
# A quick chase, which Interceptor starts for the agent; the computer
# takes the wheel during the countdown.
agent-call use_app '{"app":"interceptor","action":"quick_chase"}' 90
agent-result '"started":true'
wait-serial "interceptor offers 8 action(s)" 20
key f8
wait-serial "autopilot on" 10
wait 6
agent-call read_app '{"app":"interceptor"}' 30
agent-result '"screen":"playing"'
agent-result '"window_in_front":true'
# The Terminal takes the keyboard, and the chase waits, paused, until
# Interceptor's window is in front again.
agent-call open_app '{"app":"terminal"}' 60
agent-result opened
wait-serial "started terminal" 30
wait 2
agent-call read_app '{"app":"interceptor"}' 30
agent-result '"screen":"paused"'
agent-result '"window_in_front":false'
agent-call use_app '{"app":"interceptor","action":"resume"}' 30
agent-result "bring the window to the front first"
agent-call window '{"operation":"focus","window":"interceptor"}' 30
agent-result '"ok":true'
wait 1
agent-call use_app '{"app":"interceptor","action":"resume"}' 30
agent-result '"paused":false'
wait 3
shot target/veda/agent-games-1-in-front.png now
agent-call read_app '{"app":"interceptor"}' 30
agent-result '"screen":"playing"'
agent-call use_app '{"app":"interceptor","action":"quit_to_menu"}' 30
agent-result '"screen":"main_menu"'
# About Veda shows its licences for the agent and says what it shows:
# Veda's, the other parts' (the driver VM's Linux among them), and a part's
# texts.
agent-call use_app '{"app":"about","action":"show_licences"}' 60
agent-result "GNU General Public License"
agent-result '"licence":"GPL-2.0-only"'
wait-serial "about offers 1 action(s)" 10
agent-call use_app '{"app":"about","action":"show_licences","arguments":{"part":"musl"}}' 30
agent-result '"files":["COPYRIGHT","SOURCE"]'
agent-call read_app '{"app":"about"}' 30
agent-result '"version":"Veda 0.1.0"'
agent-result '"licences_shown":true'
wait 2
shot target/veda/agent-games-7-about.png now
