# The Calculator's agent interface, with a simulated Voice Agent service:
# the agent calculates exactly (0.1 + 0.2 is 0.3, sines of whole degrees are
# exact), in hexadecimal, converts units and uses the memory, as the keys
# would; the window shows each calculation. Forgetting the history waits for
# the user's OK.
fail-on "PANIC"
wait-serial "desktop ready" 120
mic-silence 1
agent-connected 120
wait-serial "state: Listening" 30
# The Calculator starts for the agent and describes itself.
agent-call app_actions '{"app":"calculator"}' 60
agent-result convert
wait-serial "calculator offers" 10
agent-call use_app '{"app":"calculator","action":"calculate","arguments":{"expression":"0.1+0.2"}}' 30
agent-result '"result":"0.3","exact":true'
agent-call use_app '{"app":"calculator","action":"calculate","arguments":{"expression":"12*(3+4)"}}' 30
agent-result '"expression":"12×(3+4)","result":"84"'
agent-call use_app '{"app":"calculator","action":"calculate","arguments":{"expression":"1/3"}}' 30
agent-result '"fraction":"1/3"'
agent-call use_app '{"app":"calculator","action":"calculate","arguments":{"expression":"sin(30) + sqrt(16)"}}' 30
agent-result '"result":"4.5"'
agent-call use_app '{"app":"calculator","action":"calculate","arguments":{"expression":"2 x 21"}}' 30
agent-result '"result":"42"'
agent-call use_app '{"app":"calculator","action":"calculate","arguments":{"expression":"1/0"}}' 30
agent-result "Can't divide by zero"
# Whole numbers in hexadecimal.
agent-call use_app '{"app":"calculator","action":"calculate","arguments":{"expression":"FF and F0","base":"hex"}}' 30
agent-result '"result":"F0"'
agent-result '"dec":"240"'
agent-call read_app '{"app":"calculator"}' 30
agent-result '"mode":"programmer"'
agent-result '"base":"HEX","size":"QWORD"'
# Units, exactly.
agent-call use_app '{"app":"calculator","action":"convert","arguments":{"value":100,"from":"°C","to":"fahrenheit"}}' 30
agent-result '"from":"Celsius","to":"Fahrenheit","result":"212"'
agent-call use_app '{"app":"calculator","action":"convert","arguments":{"value":1,"from":"inch","to":"cm"}}' 30
agent-result '"result":"2.54"'
agent-call use_app '{"app":"calculator","action":"convert","arguments":{"value":1,"from":"kg","to":"km"}}' 30
agent-result "do not convert"
wait 2
shot target/veda/agent-app-calculator-1-converter.png
# The memory.
agent-call use_app '{"app":"calculator","action":"memory","arguments":{"operation":"store","value":42}}' 30
agent-result '"memory":"42"'
agent-call use_app '{"app":"calculator","action":"memory","arguments":{"operation":"add","value":8}}' 30
agent-result '"memory":"50"'
agent-call use_app '{"app":"calculator","action":"set_mode","arguments":{"mode":"scientific"}}' 30
agent-call use_app '{"app":"calculator","action":"set_angle_unit","arguments":{"unit":"radians"}}' 30
agent-call use_app '{"app":"calculator","action":"calculate","arguments":{"expression":"cos(pi)"}}' 30
agent-result '"result":"-1"'
agent-call read_app '{"app":"calculator"}' 30
agent-result '"mode":"scientific"'
agent-result '"angle_unit":"radians"'
agent-result '"memory":"50"'
wait 2
shot target/veda/agent-app-calculator-2-scientific.png
# Forgetting the history needs the user's consent.
agent-call use_app '{"app":"calculator","action":"clear_history"}' 30
agent-result waiting_for_approval
wait-serial "approval 1 requested" 10
