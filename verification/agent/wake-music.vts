# The agent asleep while music plays, its sound coming back into the
# microphone as from loudspeakers: the music starts no recognition (what
# the echo canceller leaves of it is no louder than its echo can be), and
# calling the agent over it, louder than that, still wakes it, without
# what was heard before the call. During the conversation the music plays
# quieter (ducked).
agent-asleep
# Only the music comes back (no startup sound).
boot-cmdline "startup-sound=off"
boot-cmdline "run=music"
fail-on "PANIC"
wait-serial "desktop ready" 120
mic-echo -6 250
mic-silence 2
wait-serial "listening for its name" 30
wait-serial "music: library: 7 track(s)" 90
wait-serial "music: covers: 7 ready" 60
wait 1
click 0.6188 0.8125
wait-serial "music: playing Neon Horizon" 30
wait 30
agent-listens 0
checkpoint
mic-tone 2 16000
wait-serial "someone is speaking" 20
agent-hear "Na na na. Hey Veda, stop the music." 30
wait-serial "woken by its name" 20
agent-connected 60
agent-expect "Hey Veda, stop the music." 20
wait-serial "ducking the other sound" 10
