# Packages on an installed system (1280x800, a home disk), in the Terminal
# with pkg: the system image's repository is there, valid and empty; the
# image's test repository is added with its key, and hello installs with
# libgreet, which it depends on, and runs from the Terminal's PATH. Both
# are there after a restart, as is the repository; a newer index of the
# repository upgrades them; then they go, with nothing left, and nothing
# but the package manager may write where they were. What pkg does is
# checked with the shell's `logger`, which writes to the serial log, and
# by the service's own lines.
requires c-toolchain
boot-cmdline "run=terminal"
fail-on "PANIC"
wait-serial "desktop ready" 90
wait-serial "package-manager: system: 0 packages (serial 1)" 60
wait-serial "package-manager: ready (0 installed; repositories: system)" 60
wait-serial "started terminal" 60
wait 3
# Maximise the window (Super+Up).
key meta_l-up
wait 2
type "pkg repo list | grep system && pkg update && logger pkg-system-ok"
key ret
wait-serial "terminal: pkg-system-ok" 60
type "pkg search | grep 'No package is offered' && logger pkg-empty-ok"
key ret
wait-serial "terminal: pkg-empty-ok" 60
type "pkg repo add test file:///system/tests/packages/one /system/tests/packages/test.pub && pkg update && logger pkg-added-ok"
key ret
wait-serial "package-manager: added the repository test" 60
wait-serial "package-manager: test: 4 packages (serial 1)" 60
wait-serial "terminal: pkg-added-ok" 60
type "pkg install -y hello && logger pkg-installed-ok"
key ret
wait-serial "package-manager: installed hello 1.0 (from test)" 180
wait-serial "package-manager: installed libgreet 1.0 (from test)" 30
wait-serial "terminal: pkg-installed-ok" 60
type "hello; logger hello-ran-$?"
key ret
wait-serial "terminal: hello-ran-42" 60
type "pkg verify && pkg list | grep 'libgreet (for others)' && logger pkg-verified-ok"
key ret
wait-serial "terminal: pkg-verified-ok" 120
shot target/veda/packages-1-installed.png
reject-serial "package-manager: the change was not made"
# A package that would take a file of libgreet's is refused.
type "pkg install -y clash || logger pkg-clash-refused"
key ret
wait-serial "package-manager: the change was not made: clash 1.0 has a file at /home/packages/share/libgreet/greeting, which belongs to libgreet" 120
wait-serial "terminal: pkg-clash-refused" 60
# After a restart, what was installed and the repository are there.
reset
wait-serial "desktop ready" 90
expect-serial "home directory restored from the home disk"
wait-serial "package-manager: test: 4 packages (serial 1)" 60
wait-serial "package-manager: ready (2 installed; repositories: system, test)" 60
wait-serial "started terminal" 60
wait 3
key meta_l-up
wait 2
type "hello; logger hello-again-$?"
key ret
wait-serial "terminal: hello-again-42" 60
# The repository's next index upgrades them.
type "pkg repo remove test && pkg repo add test file:///system/tests/packages/two /system/tests/packages/test.pub && pkg update && logger pkg-two-ok"
key ret
wait-serial "package-manager: test: 2 packages (serial 2)" 60
wait-serial "terminal: pkg-two-ok" 60
type "pkg list --upgradable | grep hello && pkg upgrade -y && logger pkg-upgraded-ok"
key ret
wait-serial "package-manager: upgraded hello 1.0 to 2.0 (from test)" 180
wait-serial "package-manager: upgraded libgreet 1.0 to 2.0 (from test)" 30
wait-serial "terminal: pkg-upgraded-ok" 60
type "grep 2.0 /home/packages/share/hello/NEWS && hello; logger hello-two-$?"
key ret
wait-serial "terminal: hello-two-42" 60
shot target/veda/packages-2-upgraded.png
# Removed, with what was installed only for it; no one else writes there.
type "pkg remove -y hello && logger pkg-removed-ok"
key ret
wait-serial "package-manager: removed hello 2.0" 120
wait-serial "package-manager: removed libgreet 2.0" 30
wait-serial "terminal: pkg-removed-ok" 60
type "hello || touch /home/packages/planted || logger pkg-gone-ok"
key ret
wait-serial "terminal: pkg-gone-ok" 60
type "pkg verify && logger pkg-clean-ok"
key ret
wait-serial "terminal: pkg-clean-ok" 60
reject-serial "package-manager: cannot"
