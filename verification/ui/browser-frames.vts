# The browser's frames (1280x800 screen): each page is a subsurface of the
# window, whose frames the window system shows from WebKit's memory, and the
# window's own drawing over it (the find bar, the page's menu, the link
# under the pointer) is blended over it. On the host's page of a box
# crossing it (`/motion`): the page's frames reach the screen; the link
# under the pointer, the find bar and the page's menu come and go over it
# while it moves; once it has stopped, the window shows what WebKit draws of
# the page afresh (zoomed in and back), pixel for pixel; and the link's
# label shown over the page stays as it was over the page drawn afresh
# under it.
# First painted on the CPU (the browser started as the system starts), then
# composited on the GPU (started again once the GPU's service is there),
# where WebKit reads back only what changed of each frame: QEMU's GPU
# (virgl's host) cannot render into the memory the window system shows
# pages from, and the page's process says so.
boot-cmdline "run=browser:http://{web}/motion"
web-server
gpu on
memory 2048
requires web
agent-asleep
fail-on "PANIC"
wait-serial "desktop ready" 90
wait-serial "browser: pages are painted on the CPU" 60
wait 8
move 0.5 0.06
wait 1
shot target/veda/browser-frames-0-cpu-start.png
# A click starts it; then the link under the pointer, the find bar and the
# page's menu (over the box as it passes) over it, each gone again.
click 0.5 0.7
move 0.154 0.345
wait 0.5
key ctrl-f
type "Step"
wait 0.5
key esc
click 0.37 0.53 right
wait 1
key esc
move 0.5 0.06
wait 6
shot target/veda/browser-frames-1-cpu.png
expect-different target/veda/browser-frames-0-cpu-start.png target/veda/browser-frames-1-cpu.png 0.1 0.2 0.9 0.9
key ctrl-equal
wait 3
key ctrl-0
wait 5
shot target/veda/browser-frames-2-cpu-afresh.png
expect-same target/veda/browser-frames-1-cpu.png target/veda/browser-frames-2-cpu-afresh.png 0.1 0.2 0.9 0.9
# The link under the pointer named at the page's foot, over the page (its
# label is translucent), then over it drawn afresh.
move 0.154 0.345
wait 3
shot target/veda/browser-frames-3-cpu-link.png
expect-different target/veda/browser-frames-2-cpu-afresh.png target/veda/browser-frames-3-cpu-link.png 0.07 0.87 0.4 0.92
key ctrl-equal
wait 3
key ctrl-0
wait 3
move 0.16 0.345
move 0.154 0.345
wait 3
shot target/veda/browser-frames-4-cpu-link-afresh.png
expect-same target/veda/browser-frames-3-cpu-link.png target/veda/browser-frames-4-cpu-link-afresh.png 0.1 0.2 0.9 0.92
move 0.5 0.06
# Composited on the GPU.
key alt-f4
wait 4
wait-serial "service 'gpu' registered" 60
key meta_l
wait 2
type "browser"
key ret
wait-serial "browser: pages are composited on the GPU" 30
wait 4
key ctrl-l
type "{web}/motion"
key ret
wait-serial "reads its pages' frames back: the GPU cannot render into the memory the window system shows them from" 30
wait 8
move 0.5 0.06
wait 1
shot target/veda/browser-frames-5-gpu-start.png
click 0.5 0.7
move 0.154 0.345
wait 0.5
key ctrl-f
type "Step"
wait 0.5
key esc
click 0.37 0.53 right
wait 1
key esc
move 0.5 0.06
wait 6
shot target/veda/browser-frames-6-gpu.png
expect-different target/veda/browser-frames-5-gpu-start.png target/veda/browser-frames-6-gpu.png 0.1 0.2 0.9 0.9
key ctrl-equal
wait 3
key ctrl-0
wait 5
shot target/veda/browser-frames-7-gpu-afresh.png
expect-same target/veda/browser-frames-6-gpu.png target/veda/browser-frames-7-gpu-afresh.png 0.1 0.2 0.9 0.9
move 0.154 0.345
wait 3
shot target/veda/browser-frames-8-gpu-link.png
expect-different target/veda/browser-frames-7-gpu-afresh.png target/veda/browser-frames-8-gpu-link.png 0.07 0.87 0.4 0.92
key ctrl-equal
wait 3
key ctrl-0
wait 3
move 0.16 0.345
move 0.154 0.345
wait 3
shot target/veda/browser-frames-9-gpu-link-afresh.png
expect-same target/veda/browser-frames-8-gpu-link.png target/veda/browser-frames-9-gpu-link-afresh.png 0.1 0.2 0.9 0.92
move 0.5 0.06
reject-serial "page stopped working"
reject-serial "browser crashed"
reject-serial "a page's frame cannot be shown"
reject-serial "a page's subsurface"
