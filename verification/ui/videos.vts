# Videos with its decoder (mediadec: FFmpeg and dav1d) on the sample videos
# in ~/Videos (1280x800 with the taskbar): the library, then Countdown (AV1
# and FLAC, a flash and a beep on every second) played, paused, sought with
# keys and the seek bar, stepped a picture each way, its volume changed and
# muted, full screen and back, and played to its end with its sound in step
# with the pictures; then the portrait video, which has no sound. The
# window's client area starts at (90, 54).
requires media
boot-cmdline "startup-sound=off"
boot-cmdline "run=videos"
fail-on "PANIC"
fail-on "videos: panic:"
fail-on "mediadec: panic:"
wait-serial "videos: decoder: FFmpeg" 90
wait-serial "videos: library: 3 videos in /home/user/Videos" 30
wait 6
shot target/veda/videos-1-library.png
# Countdown, the second card.
key right
key ret
wait-serial "videos: playing Countdown (640x360 AV1 30 fps, FLAC 48000 Hz, 0:12)" 30
wait-serial "videos: first frame in" 10
wait 3
shot target/veda/videos-2-playing.png now
key spc
wait-serial "videos: paused at 0:0" 10
reject-serial "videos: paused at 0:00"
key spc
wait-serial "videos: resumed at 0:0" 10
# Five seconds back, then three quarters along the seek bar.
key left
wait-serial "videos: seek to 0:0" 10
wait-serial "videos: seek done in" 10
wait 1
click 0.7625 0.8188
wait-serial "videos: seek to 0:0" 10
wait-serial "videos: seek done in" 10
wait 1
# Paused, a picture forward and one back.
key spc
wait-serial "videos: paused at" 10
key dot
wait-serial "videos: step to 0:" 10
key comma
wait-serial-count "videos: step to 0:" 2 10
# Volume, mute, full screen.
key down
wait-serial "videos: volume 95%" 10
key m
wait-serial "videos: muted" 10
key m
wait-serial "videos: unmuted" 10
key f
wait-serial "videos: full screen on" 10
wait 2
shot target/veda/videos-3-full-screen.png now
key esc
wait-serial "videos: full screen off" 10
reject-serial "videos: out of sync"
reject-serial "videos: decoder too slow"
reject-serial "videos: cannot"
reject-serial "videos: decoder stopped"
# From the start to the end: the sound in step with the pictures (its
# statistics are the new playback's).
checkpoint
key home
wait-serial "videos: seek to 0:00" 10
key spc
wait-serial "videos: resumed at 0:00" 10
wait-serial "videos: playback:" 15
wait-serial "videos: finished Countdown" 20
wait 2
shot target/veda/videos-4-ended.png
reject-serial "videos: out of sync"
reject-serial "videos: decoder too slow"
reject-serial "videos: cannot"
reject-serial "videos: decoder stopped"
expect-audio
# The portrait video, without sound, to its end.
key esc
wait-serial "videos: showing the library" 10
key home
key right
key right
key ret
wait-serial "videos: playing Rising Bubbles (360x640 AV1 30 fps, no sound, 0:06)" 30
wait 3
shot target/veda/videos-5-portrait.png now
wait-serial "videos: finished Rising Bubbles" 15
key esc
wait-serial-count "videos: showing the library" 2 10
wait 2
shot target/veda/videos-6-library-watched.png
