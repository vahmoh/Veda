# The wired card's cable plugged in as the driver VM attaches the card, then
# unplugged and plugged in again: the default route comes with the link,
# goes with it and comes back with it. nettest reports the interface of the
# default route and whether the gateway and DNS answer.
net ethernet
boot-cmdline "run=nettest:route-watch"
link wired off

# 1. Plug the cable in as the driver VM's net has found the card and attaches
# it, link down: the carrier rises about when netd is told, and netd must
# hear that the link is up.
wait-serial "net: eth0 (" 120
link wired on
wait-serial "watch: route=eth0 ping=ok dns=ok" 120

# 2. Unplug the cable: no route is left.
checkpoint
link wired off
wait-serial "eth0: link down" 30
wait-serial "watch: route=none" 60

# 3. Plug it back in: the wired connection carries traffic again.
checkpoint
link wired on
wait-serial "watch: route=eth0 ping=ok dns=ok" 90
reject-serial "panicked"
