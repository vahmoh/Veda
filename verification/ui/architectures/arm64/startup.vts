# The startup sequence on QEMU's ARM64 machine (1024x768). No driver comes
# for the display, AAVMF's framebuffer in the machine's memory (`ramfb`),
# which the compositor draws into itself. The boot loader clears the screen,
# which stays black until the splash fades in from black and comes to life
# (the light around the ring, the name and the tagline); once the desktop
# has drawn itself and the startup sound is ready (the sound card is the
# driver VM's), it dissolves into the desktop as the sound starts.
sound hda
fail-on "PANIC"
wait-serial "compositor: display" 120
shot target/veda/startup-0-black.png now
expect-black target/veda/startup-0-black.png
wait-serial "compositor: no driver is coming for the display" 120
wait-serial "compositor: the splash fades in" 120
wait 1.3
shot target/veda/startup-1-splash.png now
wait-serial "compositor: the desktop appears" 60
wait-serial "shell: startup sound: playing" 10
wait-serial "compositor: desktop shown after" 60
wait 1
shot target/veda/startup-2-desktop.png
reject-serial "startup sound: no sound card"
reject-serial "no desktop after"
reject-serial "did not say the desktop may appear"
reject-serial "did not show its first picture"
expect-audio
expect-audio-gapless
