# The driver VM's bridge: a Linux program in the guest uses Veda's IPC
# through `runtime`, as a Veda program does
# (implementation/guests/linux/bridgetest). It sees Veda's registry
# narrowed to the services drivers attach to, sends a VMO and an event over
# a channel, maps the VMO, and waits on events and channels (with
# deadlines, and woken by another thread).
boot-cmdline "driver-virtual-machine.run=bridgetest driver-virtual-machine.poweroff"
fail-on "PANIC"
fail-on "bridgetest: FAIL"
fail-on "driver-virtual-machine: processor"
wait-serial "driver-virtual-machine: starting Linux" 60
wait-serial "bridgetest: PASS" 60
wait-serial "driver-virtual-machine: Linux powered the machine off" 30
