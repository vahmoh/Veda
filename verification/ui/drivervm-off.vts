# `driver-virtual-machine=off` keeps the driver VM off where the machine
# could run it: the device manager says so, and the desktop comes up without
# Linux.
boot-cmdline "driver-virtual-machine=off"
fail-on "PANIC"
wait-serial "device-manager: no driver VM (driver-virtual-machine=off)" 60
wait-serial "shell: desktop ready" 60
reject-serial "driver-virtual-machine: linux:"
