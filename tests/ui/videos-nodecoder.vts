# Videos without its decoder (as in an image built without the C
# toolchain, where /system/bin/mediadec is missing; here a decoder that does
# not exist is named): a video opened says that playback isn't available and
# why, and the library says so above the videos.
boot-cmdline "run=videos:--decoder,/system/bin/nodecoder,/system/tests/videos/fake/pattern.mkv"
fail-on "PANIC"
fail-on "videos: panic:"
wait-serial "videos: decoder unavailable: /system/bin/nodecoder does not exist" 90
wait-serial "videos: cannot play pattern.mkv: Video playback isn't available" 30
wait 3
shot target/veda/videos-nodecoder-1-player.png
key esc
wait-serial "videos: showing the library" 10
wait 3
shot target/veda/videos-nodecoder-2-library.png
reject-serial "videos: library: /system/tests/videos/fake"
