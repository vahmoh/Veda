# Damaged files (1280x800 with the taskbar): a copy of Countdown cut short
# plays until its data ends and finishes there, and a file that is not a
# video is refused with a message saying so, in the player and on its card
# in the library.
requires media
boot-cmdline "run=terminal"
fail-on "PANIC"
fail-on "videos: panic:"
fail-on "mediadec: panic:"
wait-serial "desktop ready" 90
wait-serial "started terminal" 60
wait 3
type "cp /system/tests/videos/Truncated.mkv /home/user/Videos/"
key ret
wait 1
type "echo not a video "
key shift-dot
type " /home/user/Videos/Broken.mp4"
key ret
wait 1
type "open /home/user/Videos/Truncated.mkv"
key ret
wait-serial "videos: playing Countdown (640x360 AV1 30 fps, FLAC 48000 Hz, 0:12)" 60
wait-serial "videos: finished Countdown" 30
wait 2
shot target/veda/videos-errors-1-truncated.png
key alt-tab
wait 2
type "open /home/user/Videos/Broken.mp4"
key ret
wait-serial "videos: cannot play Broken.mp4: This file isn't a video Videos can open, or it is damaged." 30
wait 2
shot target/veda/videos-errors-2-broken.png
key esc
wait-serial "videos: showing the library" 10
wait 5
shot target/veda/videos-errors-3-library.png
reject-serial "videos: decoder stopped"
