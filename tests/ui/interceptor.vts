# Interceptor: a pursuit at night through Veda Bay's traffic, rendered on
# the host's GPU where QEMU has one (in software otherwise). It starts and
# keeps rendering (its frame statistics reach the log); the computer takes
# the wheel (F8) and chases the suspect.
boot-cmdline "run=interceptor"
fail-on "PANIC"
fail-on "link: "
fail-on "shader:"
fail-on "cannot render on the GPU"
fail-on "rendering stops"
wait-serial "interceptor: ready" 120
wait 3
shot target/veda/interceptor-1.png
key f8
wait-serial "autopilot on" 10
wait 12
shot target/veda/interceptor-2-chase.png
wait-serial " fps, render " 30
wait 8
shot target/veda/interceptor-3-chase.png
