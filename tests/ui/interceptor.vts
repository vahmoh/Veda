# Interceptor: from the title, through the menus, to the first career
# mission at Veda Bay, full screen, rendered on the host's GPU where QEMU
# has one (in software otherwise). The title and the menus show the
# showcase chase behind them; the mission counts down; the computer takes
# the wheel (F8) and chases the suspect; the game pauses and resumes; the
# chase ends on the results screen. The computer takes the wheel before
# the start, so that every run plays the same chase (the cars, their
# drivers and the chase step at a fixed rate, whatever the frames): the
# suspect is taken down 50 s after the start. Taking it later, the chase
# would last anything from under a minute to eight, by the moment the
# key landed. Resuming from the pause carries on with that chase (Enter
# on the pause menu, the hidden pointer resting on another item).
boot-cmdline "run=interceptor"
fail-on "PANIC"
fail-on "link: "
fail-on "shader:"
fail-on "cannot render on the GPU"
fail-on "rendering stops"
fail-on "cannot change the light"
wait-serial "interceptor: ready" 120
wait 4
shot target/veda/interceptor-1-title.png
key ret
wait-serial "screen Main" 10
wait 2
shot target/veda/interceptor-2-menu.png
key ret
wait-serial "screen Career" 10
wait 2
shot target/veda/interceptor-3-career.png
key ret
wait-serial "screen Playing" 10
key f8
wait-serial "autopilot on" 10
wait 1
shot target/veda/interceptor-4-countdown.png
wait 12
shot target/veda/interceptor-5-chase.png
key esc
wait-serial "screen Paused" 10
wait 2
shot target/veda/interceptor-6-paused.png
key ret
wait-serial "screen Playing" 10
wait-serial " fps, render " 30
wait 5
shot target/veda/interceptor-7-chase.png
wait-serial "result: taken down in 0:49.9, 8 hits" 120
wait 4
shot target/veda/interceptor-8-results.png
