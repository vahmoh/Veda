# Opening videos from the Terminal (1280x800 with the taskbar): `open`
# starts Videos with the file, which plays at once with its folder as the
# library; a second `open` hands the next file to the player that is
# running, as Files and the desktop do.
requires media
boot-cmdline "run=terminal"
fail-on "PANIC"
fail-on "videos: panic:"
wait-serial "desktop ready" 90
wait-serial "started terminal" 60
wait 3
type "open /home/user/Videos/Countdown.mkv"
key ret
wait-serial "videos: playing Countdown" 60
wait-serial "videos: first frame in" 10
wait 3
shot target/veda/videos-open-1.png
# Back to the Terminal: the next video goes to the running player.
key alt-tab
wait 2
type 'open "/home/user/Videos/Aurora Timelapse.mkv"'
key ret
wait-serial "handed /home/user/Videos/Aurora Timelapse.mkv to the running player" 30
wait-serial "videos: opening /home/user/Videos/Aurora Timelapse.mkv" 10
wait-serial "videos: playing Aurora Timelapse (1280x720 AV1 24 fps, FLAC 48000 Hz, 0:16)" 30
wait 3
shot target/veda/videos-open-2.png
reject-serial "videos: cannot"
