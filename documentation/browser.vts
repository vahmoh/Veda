# The browser's picture in the README (1280x800). Regenerate it with
#
#   cargo automation script documentation/browser.vts
#
# which writes documentation/images/browser.png: the browser, started from
# the start menu's search, shows Veda's website, www.vedaos.org, so the
# host must reach the Internet. The web engine must be built
# (`cargo automation web`).
requires web
memory 2048
agent-asleep
fail-on "PANIC"
wait-serial "desktop ready" 90
wait-serial "Routable via eth0" 120
wait 6
key meta_l
wait 2
type "browser"
key ret
wait-serial "browser: pages are" 30
wait 4
type "www.vedaos.org"
key ret
wait 12
move 0.97 0.08
wait 2
shot documentation/images/browser.png now
reject-serial "page stopped working"
