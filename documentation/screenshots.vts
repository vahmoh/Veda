# The screenshots in the README (1280x800). Regenerate them with
#
#   cargo orchestration script documentation/screenshots.vts
#
# which writes documentation/images/*.png. Applications are started from
# the start menu's search and the Terminal, so only Music's play button,
# Paint's tools and a few things on the taskbar are clicked by position. The machine is on QEMU's wired network,
# and the agent talks to the stand-in for Deepgram. GCC and the video
# decoder must be in the image (`cargo orchestration toolchain`).
# Interceptor's picture has a script of its own, shot at 1920x1200 and
# scaled to 1280x800 (`documentation/interceptor.vts`).
requires native-toolchain
agent-asleep
fail-on "PANIC"
wait-serial "desktop ready" 90
wait-serial "Routable via eth0" 120
wait 6

# The desktop with the agent's window open, listening (the ring on the
# taskbar opens it and wakes the agent).
click 0.825 0.97
wait-serial "state: Listening" 30
move 0.97 0.08
wait 3
shot documentation/images/desktop.png now
# The agent back to sleep (the ring in its window), and the window closed.
checkpoint
click 0.8578 0.61
wait-serial "state: Asleep" 20
click 0.825 0.97
wait 2

# A Rust program in the Text Editor: the Terminal writes it and opens it.
key meta_l
wait 2
type "terminal"
key ret
wait-serial "started terminal" 30
wait 4
type "echo -e '//! The prime numbers below a limit, by the sieve of Eratosthenes.\n' > Documents/primes.rs"
key ret
type "echo -e '/// Returns every prime number smaller than `limit`.\npub fn primes_below(limit: usize) -> Vec<usize> {\n    let mut composite = vec![false; limit];\n    let mut primes = Vec::new();' >> Documents/primes.rs"
key ret
type "echo -e '    for n in 2..limit {\n        if composite[n] {\n            continue;\n        }\n        primes.push(n);' >> Documents/primes.rs"
key ret
type "echo -e '        // Every multiple of a prime is composite.\n        for multiple in (n * n..limit).step_by(n) {\n            composite[multiple] = true;\n        }\n    }\n    primes\n}\n' >> Documents/primes.rs"
key ret
type "echo -e '#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn small_primes() {\n        assert_eq!(primes_below(20), [2, 3, 5, 7, 11, 13, 17, 19]);\n    }\n}' >> Documents/primes.rs"
key ret
wait 1
type "edit Documents/primes.rs && exit"
key ret
wait-serial "started editor" 30
move 0.97 0.08
wait 6
shot documentation/images/editor.png
key alt-f4
wait-serial "editor exited" 20
wait 2

# Photos: the picture library.
key meta_l
wait 2
type "photos"
key ret
wait-serial "started photos" 30
move 0.97 0.08
wait 10
shot documentation/images/photos.png
key alt-f4
wait-serial "photos exited" 20
wait 2

# Music, playing the first track.
key meta_l
wait 2
type "music"
key ret
wait-serial "music: covers: 7 ready" 60
wait 1
click 0.6188 0.8125
wait-serial "music: playing" 30
move 0.97 0.08
wait 6
shot documentation/images/music.png now
key alt-f4
wait-serial "music exited" 20
wait 2

# Videos: the aurora timelapse, the library's first video, playing, the
# pointer on its seek bar (which shows a picture from further on).
key meta_l
wait 2
type "videos"
key ret
wait-serial "videos: library: 3 videos" 30
wait 2
key ret
wait-serial "videos: playing Aurora Timelapse" 30
wait 6
move 0.66 0.8188
wait 3
shot documentation/images/videos.png now
key alt-f4
wait-serial "videos exited" 20
wait 2

# Settings, on the agent's page: the Terminal starts it there.
key meta_l
wait 2
type "terminal"
key ret
wait-serial "started terminal" 30
wait 4
type "run settings agent && exit"
key ret
wait-serial "started settings" 30
move 0.97 0.08
wait 8
shot documentation/images/agent-settings.png
key alt-f4
wait-serial "settings exited" 20
wait 2

# Files: the pictures as thumbnails.
key meta_l
wait 2
type "files"
key ret
wait-serial "started files" 30
wait 3
key ctrl-l
type "/home/user/Pictures"
key ret
wait 2
key ctrl-2
move 0.97 0.08
wait 8
shot documentation/images/files.png
key alt-f4
wait-serial "files exited" 20
wait 2

# Paint: Retro Sunset with stars drawn in its sky and a greeting written on
# it. The Terminal starts Paint with the picture; the tools, colours and
# options are clicked by position, and the picture is drawn on at 100%.
key meta_l
wait 2
type "terminal"
key ret
wait-serial "started terminal" 30
wait 4
type "run paint 'Pictures/Retro Sunset.bmp' && exit"
key ret
wait-serial "opened /home/user/Pictures/Retro Sunset.bmp" 30
wait 2
# White stars, filled, each placed with Enter.
key o
click 0.4438 0.16
click 0.1148 0.2075
click 0.6078 0.1263
drag 0.6875 0.3125 0.7219 0.3675
key ret
drag 0.7531 0.4075 0.7688 0.4325
key ret
drag 0.6328 0.3 0.6484 0.325
key ret
drag 0.2578 0.4375 0.2703 0.4575
key ret
# The greeting, in white bold at 56 pixels.
key t
click 0.1094 0.2075
click 0.2977 0.2075
click 0.2344 0.2975
type "Hello, Veda!"
key esc
move 0.97 0.08
wait 3
shot documentation/images/paint.png
# Undone, so that Paint closes without asking to save.
key ctrl-z
key ctrl-z
key ctrl-z
key ctrl-z
key ctrl-z
key ctrl-z
wait 1
key alt-f4
wait-serial "paint exited" 20
wait 2

# The Calculator, at the size it opens at, in Scientific mode, after a few
# calculations typed on the keyboard.
key meta_l
wait 2
type "calculator"
key ret
wait-serial "started calculator" 30
wait 3
key alt-2
type "10!="
type "sin(30)+cos(60)="
type "2^64="
type "0.1+0.2="
type "(1+sqrt(5))/2="
move 0.97 0.08
wait 3
shot documentation/images/calculator.png
key alt-f4
wait-serial "calculator exited" 20
wait 2

# GCC in the Terminal: a C program with a mistake, which GCC finds. It runs
# once first, to have its programs read from the disk, then for the
# picture; that run has no line in the log to wait for.
key meta_l
wait 2
type "terminal"
key ret
wait-serial "started terminal" 30
wait 4
type "echo -e 'int main(void)\n{\n    int sum = 0;\n    for (int i = 1; i <= 100; i++)\n        sum += i;\n    return total;\n}' > sum.c"
key ret
wait 1
type "gcc -Wall -o sum sum.c; logger warm-$?"
key ret
wait-serial "terminal: warm-1" 600
type "clear"
key ret
wait 1
type "gcc --version && cat sum.c"
key ret
wait 4
type "gcc -Wall -o sum sum.c"
key ret
wait 40
move 0.97 0.08
wait 3
shot documentation/images/gcc.png
# The Terminals before this one exited too (with `exit`).
checkpoint
key alt-f4
wait-serial "terminal exited" 20
wait 2

# The lock screen, with a password set in Settings (the Terminal starts it
# on its page): resting, then asking for the password, half typed.
key meta_l
wait 2
type "terminal"
key ret
wait-serial "started terminal" 30
wait 4
type "run settings lock && exit"
key ret
wait-serial "started settings" 30
wait 4
type "veda1234"
key tab
type "veda1234"
key ret
wait-serial "lock: the password was set" 30
key alt-f4
wait-serial "settings exited" 20
wait 2
key meta_l-l
wait-serial "lock: the screen is locked" 20
move 0.97 0.08
wait 3
shot documentation/images/lock.png
type "veda"
wait 2
shot documentation/images/lock-password.png
