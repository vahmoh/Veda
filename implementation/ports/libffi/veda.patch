--- a/src/closures.c
+++ b/src/closures.c
@@ -27,7 +27,7 @@
    DEALINGS IN THE SOFTWARE.
    ----------------------------------------------------------------------- */
 
-#if (defined __linux__ || defined __CYGWIN__) && !defined _GNU_SOURCE
+#if (defined __linux__ || defined __CYGWIN__ || defined __veda__) && !defined _GNU_SOURCE
 #define _GNU_SOURCE 1
 #endif
 
@@ -141,6 +141,11 @@
    executable memory. */
 #  define FFI_MMAP_EXEC_WRIT 1
 # endif
+# if defined(__veda__)
+/* Veda: what malloc returns cannot be executed, and closures are made as
+   where SELinux is enforced (below). */
+#  define FFI_MMAP_EXEC_WRIT 1
+# endif
 #endif
 
 #if FFI_MMAP_EXEC_WRIT && defined(__linux__) && !defined(__ANDROID__)
@@ -477,6 +482,13 @@
 #define is_selinux_enabled() (selinux_enabled >= 0 ? selinux_enabled \
 			      : (selinux_enabled = selinux_enabled_check ()))
 
+#elif defined(__veda__)
+
+/* Veda: no memory is both writable and executable, as SELinux would have
+   it: a closure's code is a memory file's, mapped at two addresses, where
+   it is written and where it is executed (dlmmap_locked). */
+#define is_selinux_enabled() 1
+
 #else
 
 #define is_selinux_enabled() 0
