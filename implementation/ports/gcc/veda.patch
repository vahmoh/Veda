+<http://www.gnu.org/licenses/>.  */
+
+/* Veda's C library is musl.  A program is linked statically by default,
+   at a fixed address, or as a position-independent executable that
+   relocates itself (-static-pie); or dynamically, as a position-independent
+   executable (-pie) that the system's dynamic linker links with the C
+   library's shared object and its other libraries as it starts.  Shared
+   libraries (-shared) stand on the C library's shared object too.  The
+   system lives under /system: headers in /system/include, libraries and
+   start files in /system/lib.  */
+
+#undef  TARGET_OS_CPP_BUILTINS
+#define TARGET_OS_CPP_BUILTINS()		\
+  do						\
+    {						\
+      builtin_define ("__veda__");		\
+      builtin_define_std ("unix");		\
+      builtin_assert ("system=veda");		\
+      builtin_assert ("system=unix");		\
+      builtin_assert ("system=posix");		\
+    }						\
+  while (0)
+
+#undef  CPP_SPEC
+#define CPP_SPEC "%{posix:-D_POSIX_SOURCE} %{pthread:-D_REENTRANT}"
+
+/* C++ sees the C library's GNU extensions, as on GNU/Linux: libstdc++
+   and the programs written for it expect them.  */
+#undef  CPLUSPLUS_CPP_SPEC
+#define CPLUSPLUS_CPP_SPEC "-D_GNU_SOURCE %(cpp)"
+
+/* The libraries and start files are in /system/lib (under the sysroot
+   when cross compiling).  */
+#undef  STANDARD_STARTFILE_PREFIX_1
+#define STANDARD_STARTFILE_PREFIX_1 "/system/lib/"
+#undef  STANDARD_STARTFILE_PREFIX_2
+#define STANDARD_STARTFILE_PREFIX_2 ""
+
+/* The compiler that runs on Veda finds the assembler and the linker with
+   the system's programs (a cross compiler does not look there).  */
+#undef  MD_EXEC_PREFIX
+#define MD_EXEC_PREFIX "/system/bin/"
+
+/* The dynamic linker, which dynamically linked programs name: the C
+   library's shared object, as musl's is.  */
+#define VEDA_DYNAMIC_LINKER "/system/lib/libc.so"
+
+/* Which output is made, the options winning over one another in this
+   order: -shared (a shared library always stands on the C library's
+   shared object), -static (over -static-pie and -pie, as on GNU/Linux),
+   -static-pie, -pie; and -shared and -pie over each other, whichever
+   comes last, as GCC's options have them.  */
+#undef  STARTFILE_SPEC
+#define STARTFILE_SPEC \
+  "%{shared:;static:crt1.o%s;static-pie:rcrt1.o%s;pie:Scrt1.o%s;:crt1.o%s} crti.o%s \
+   %{shared:crtbeginS.o%s;static:crtbeginT.o%s;static-pie|pie:crtbeginS.o%s;:crtbeginT.o%s}"
+
+#define VEDA_ENDFILE_SPEC \
+  "%{shared:crtendS.o%s;static:crtend.o%s;static-pie|pie:crtendS.o%s;:crtend.o%s} crtn.o%s"
+
+#undef  ENDFILE_SPEC
+#define ENDFILE_SPEC VEDA_ENDFILE_SPEC
+
+/* musl has its threads in libc.  */
+#undef  LIB_SPEC
+#define LIB_SPEC "%{pthread:} -lc"
+
+/* What is linked dynamically is linked as GNU/Linux distributions link
+   it: no relocations of code, which would need memory both writable and
+   executable (-z text); what is relocated read-only before any code runs
+   (-z relro -z now); the GNU hash table alone; relative relocations packed
+   (DT_RELR); and a search path given (-rpath) as DT_RUNPATH.  */
+#define VEDA_DYNAMIC_LINK_SPEC \
+  "-z text -z relro -z now --hash-style=gnu -z pack-relative-relocs --enable-new-dtags"
+
+/* The linker's options for each kind of output, which wins as in
+   STARTFILE_SPEC.  */
+#undef  LINK_SPEC
+#define LINK_SPEC \
+  "%{shared:-shared " VEDA_DYNAMIC_LINK_SPEC "; \
+     static:-static; \
+     static-pie:-static -pie --no-dynamic-linker -z text; \
+     pie:-pie -dynamic-linker " VEDA_DYNAMIC_LINKER " " VEDA_DYNAMIC_LINK_SPEC "; \
+     :-static} \
+   %{rdynamic:-export-dynamic} %{s:-s}"
+
+/* LINK_SPEC gives -pie its meaning: a dynamically linked
+   position-independent executable, as on GNU/Linux.  */
+#undef  LINK_PIE_SPEC
+#define LINK_PIE_SPEC ""
+
+/* GCC's runtime: a statically linked program has its own (libgcc.a, and
+   the unwinder in libgcc_eh.a); dynamically linked programs and shared
+   libraries share the unwinder, libgcc_s.so.1, as on GNU/Linux, so that a
+   process has one, which knows every object's frames and those registered
+   with it.  It is linked if used (libstdc++.so.6 uses it), or always with
+   -shared-libgcc; the rest of libgcc is static.  */
+#undef  REAL_LIBGCC_SPEC
+#define REAL_LIBGCC_SPEC \
+  "%{static|static-pie|static-libgcc:-lgcc -lgcc_eh; \
+     shared|pie:%{shared-libgcc:-lgcc_s -lgcc;:-lgcc --push-state --as-needed -lgcc_s --pop-state}; \
+     :-lgcc -lgcc_eh}"
+
+/* The C library and libgcc refer to each other.  */
+#undef  LINK_GCC_C_SEQUENCE_SPEC
+#define LINK_GCC_C_SEQUENCE_SPEC "--start-group %G %{!nolibc:%L} --end-group"
+
+#if defined(HAVE_LD_EH_FRAME_HDR)
+#define LINK_EH_SPEC "%{shared:--eh-frame-hdr;static:;static-pie|pie:--eh-frame-hdr} "
+#endif
+
+#define TARGET_POSIX_IO
+
+/* musl has the C99 functions and sincos.  */
+#undef  TARGET_LIBC_HAS_FUNCTION
+#define TARGET_LIBC_HAS_FUNCTION gnu_libc_has_function
+
+/* The C library is musl.  */
+#undef  OPTION_MUSL
+#define OPTION_MUSL 1
+#undef  OPTION_MUSL_P
+#define OPTION_MUSL_P(opts) 1
