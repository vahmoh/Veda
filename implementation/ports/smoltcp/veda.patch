+/// Veda: the packet an error message quotes, of which routers send the
+/// header and the first 64 bits of its data (RFC 792), or as much as fits
+/// in 576 bytes (RFC 1812): the header must be whole, the rest need not be.
+/// (`Ipv4Packet::new_checked` wants the whole packet, as long as its header
+/// says, which dropped the errors about all but the shortest packets.)
+fn quoted_packet(data: &[u8]) -> Result<Ipv4Packet<&[u8]>> {
+    if data.len() < IPV4_HEADER_LEN {
+        return Err(Error);
+    }
+    let packet = Ipv4Packet::new_unchecked(data);
+    let header_len = packet.header_len() as usize;
+    if header_len < IPV4_HEADER_LEN || header_len > data.len() {
+        return Err(Error);
+    }
+    Ok(packet)
+}
