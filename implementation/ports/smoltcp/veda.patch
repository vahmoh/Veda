+/// Veda: with a secret, autoconfigured addresses keep the hardware address
+/// to themselves (RFC 7217).
+#[test]
+#[cfg(all(feature = "proto-ipv6-slaac", feature = "medium-ethernet"))]
+fn test_slaac_stable_privacy_addresses() {
+    let mut device = crate::tests::TestingDevice::new(Medium::Ethernet);
+    let hw = HardwareAddress::Ethernet(EthernetAddress([0x02, 0x02, 0x02, 0x02, 0x02, 0x02]));
+    let mut config = Config::new(hw);
+    config.slaac = true;
+    config.slaac_secret = Some([7; 32]);
+    let mut iface = Interface::new(config, &mut device, Instant::ZERO);
+    let prefix = Ipv6Cidr::new(Ipv6Address::new(0x2001, 0xdb8, 0x3, 0, 0, 0, 0, 0), 64);
+    let router = Ipv6Address::new(0xfe80, 0, 0, 0, 0x5054, 0xff, 0xfe00, 0);
+    let info = NdiscPrefixInformation {
+        prefix: prefix.address(),
+        prefix_len: 64,
+        flags: NdiscPrefixInfoFlags::ADDRCONF,
+        valid_lifetime: Duration::from_secs(600),
+        preferred_lifetime: Duration::from_secs(300),
+    };
+    iface.inner.slaac.process_advertisement(
+        &router,
+        Duration::from_secs(600),
+        Some(info),
+        Instant::ZERO,
+    );
+    iface.poll_maintenance(Instant::ZERO);
+    let formed: std::vec::Vec<Ipv6Cidr> = iface
+        .ip_addrs()
+        .iter()
+        .filter_map(|c| match c {
+            IpCidr::Ipv6(c) if prefix.contains_addr(&c.address()) => Some(*c),
+            _ => None,
+        })
+        .collect();
+    assert_eq!(formed.len(), 1);
+    assert_eq!(Some(formed[0]), iface.ipv6_address_in(&prefix));
+    assert_ne!(Some(formed[0]), Ipv6Cidr::from_link_prefix(&prefix, hw));
+    // Link-local too, and only /64 prefixes.
+    let ll = Ipv6Cidr::new(Ipv6Cidr::LINK_LOCAL_PREFIX.address(), 64);
+    assert_ne!(
+        iface.ipv6_address_in(&ll),
+        Ipv6Cidr::from_link_prefix(&ll, hw)
+    );
+    assert_eq!(
+        iface.ipv6_address_in(&Ipv6Cidr::new(prefix.address(), 48)),
+        None
+    );
+}
