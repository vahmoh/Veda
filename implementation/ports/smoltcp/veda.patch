+        // An echo request with 56 bytes of data, of which a router quotes
+        // the ICMP header.
+        let header = Ipv4Repr {
+            src_addr: Ipv4Address::new(10, 0, 2, 15),
+            dst_addr: Ipv4Address::new(192, 0, 2, 7),
+            next_header: IpProtocol::Icmp,
+            payload_len: 64,
+            hop_limit: 1,
+        };
+        let request = [0x08, 0x00, 0x00, 0x00, 0x12, 0x34, 0x00, 0x07];
+        for (message, code) in [(Message::TimeExceeded, 0), (Message::DstUnreachable, 1)] {
+            let mut bytes = [0u8; 8 + 20 + 8];
+            let mut packet = Packet::new_unchecked(&mut bytes[..]);
+            packet.set_msg_type(message);
+            packet.set_msg_code(code);
+            let quoted = packet.data_mut();
+            header.emit(
+                &mut Ipv4Packet::new_unchecked(&mut quoted[..20]),
+                &ChecksumCapabilities::default(),
+            );
+            quoted[20..].copy_from_slice(&request);
+            packet.fill_checksum();
+            let packet = Packet::new_unchecked(&bytes[..]);
+            let repr = Repr::parse(&packet, &ChecksumCapabilities::default()).unwrap();
+            let quoted = Ipv4Repr {
+                payload_len: 8,
+                ..header
+            };
+            let expected = match message {
+                Message::TimeExceeded => Repr::TimeExceeded {
+                    reason: TimeExceeded::TtlExpired,
+                    header: quoted,
+                    data: &request,
+                },
+                _ => Repr::DstUnreachable {
+                    reason: DstUnreachable::HostUnreachable,
+                    header: quoted,
+                    data: &request,
+                },
+            };
+            assert_eq!(repr, expected);
+            // The quoted header must be whole, and eight bytes of data
+            // follow it.
+            for len in [8 + 19, 8 + 20 + 7] {
+                let mut short = bytes[..len].to_vec();
+                let mut packet = Packet::new_unchecked(&mut short[..]);
+                packet.fill_checksum();
+                let packet = Packet::new_unchecked(&short[..]);
+                assert_eq!(
+                    Repr::parse(&packet, &ChecksumCapabilities::default()),
+                    Err(Error)
+                );
+            }
+        }
