@@ -16181,6 +16184,22 @@
   hardcode_into_libs=yes
   ;;
 
+# Veda: ELF, and musl's dynamic linker (the C library's shared object),
+# which looks in LD_LIBRARY_PATH, then the RUNPATHs, then /system/lib and
+# /home/packages/lib.
+veda*)
+  version_type=linux # correct to gnu/linux during the next big refactor
+  need_lib_prefix=no
+  need_version=no
+  library_names_spec='$libname$release$shared_ext$versuffix $libname$release$shared_ext$major $libname$shared_ext'
+  soname_spec='$libname$release$shared_ext$major'
+  shlibpath_var=LD_LIBRARY_PATH
+  shlibpath_overrides_runpath=yes
+  hardcode_into_libs=yes
+  sys_lib_dlsearch_path_spec='/system/lib /home/packages/lib'
+  dynamic_linker='Veda ld.so'
+  ;;
+
 uts4*)
   version_type=linux # correct to gnu/linux during the next big refactor
   library_names_spec='$libname$release$shared_ext$versuffix $libname$release$shared_ext$major $libname$shared_ext'
