+    posix_spawn_file_actions_t actions;
+    posix_spawnattr_t attr;
+    /* Copies of c2pwrite and errwrite, where the duplications onto the
+       standard descriptors would overwrite them first (#12607). */
+    int copies[2] = {-1, -1};
+    short flags = 0;
+    pid_t pid = -1;
+    int first_error = 0;
+    int err;
+
+    *in_chdir = 0;
+    if ((err = posix_spawn_file_actions_init(&actions)) != 0) {
+        *error = err;
+        return -1;
+    }
+    if ((err = posix_spawnattr_init(&attr)) != 0) {
+        posix_spawn_file_actions_destroy(&actions);
+        *error = err;
+        return -1;
+    }
+
+    /* The descriptors passed on, inheritable in the child: a duplication
+       onto itself clears FD_CLOEXEC. errpipe_write stays the parent's. */
+    for (Py_ssize_t i = 0; i < fds_to_keep_len; i++) {
+        int fd = fds_to_keep[i];
+        if (fd != errpipe_write &&
+            (err = posix_spawn_file_actions_adddup2(&actions, fd, fd)) != 0) {
+            goto done;
+        }
+    }
+    if (c2pwrite == 0) {
+        if ((c2pwrite = copies[0] = fcntl(c2pwrite, F_DUPFD_CLOEXEC, 3)) < 0) {
+            err = errno;
+            goto done;
+        }
+    }
+    if (errwrite == 0 || errwrite == 1) {
+        if ((errwrite = copies[1] = fcntl(errwrite, F_DUPFD_CLOEXEC, 3)) < 0) {
+            err = errno;
+            goto done;
+        }
+    }
+    if ((p2cread != -1 &&
+         (err = posix_spawn_file_actions_adddup2(&actions, p2cread, 0)) != 0) ||
+        (c2pwrite != -1 &&
+         (err = posix_spawn_file_actions_adddup2(&actions, c2pwrite, 1)) != 0) ||
+        (errwrite != -1 &&
+         (err = posix_spawn_file_actions_adddup2(&actions, errwrite, 2)) != 0)) {
+        goto done;
+    }
+    if (cwd != NULL &&
+        (err = posix_spawn_file_actions_addchdir_np(&actions, cwd)) != 0) {
+        goto done;
+    }
+    if (close_fds) {
