+           those open without FD_CLOEXEC. */
+        long max_fd = safe_get_max_fd();
+        for (int fd = 3; fd < max_fd; fd++) {
+            if (_is_fd_in_sorted_fd_sequence(fd, fds_to_keep, fds_to_keep_len)) {
+                continue;
+            }
+            int fd_flags = fcntl(fd, F_GETFD);
+            if (fd_flags == -1 || (fd_flags & FD_CLOEXEC)) {
+                continue;
+            }
+            if ((err = posix_spawn_file_actions_addclose(&actions, fd)) != 0) {
+                goto done;
+            }
+        }
+    }
