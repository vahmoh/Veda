# What CPython's configure would learn by running programs on AMD64, after
# Veda's answers (../../config.site): the System V ABI's types and the
# processor's arithmetic.
ac_cv_aligned_required=no
ac_cv_wchar_t_signed=yes
ac_cv_rshift_extends_sign=yes

# libffi passes complex numbers as the System V ABI has them (ctypes's
# c_double_complex and the like).
ac_cv_ffi_complex_double_supported=yes
