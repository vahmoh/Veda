# What CPython's configure would learn by running programs on ARM64, after
# Veda's answers (../../config.site): the AAPCS64's types and the
# processor's arithmetic. (wchar_t is unsigned here.)
ac_cv_aligned_required=no
ac_cv_wchar_t_signed=no
ac_cv_rshift_extends_sign=yes

# libffi passes complex numbers as the AAPCS64 has them (ctypes's
# c_double_complex and the like).
ac_cv_ffi_complex_double_supported=yes
