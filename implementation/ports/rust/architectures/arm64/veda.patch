@@ -0,0 +1,29 @@
+use crate::spec::{Arch, Cc, FramePointer, LinkerFlavor, Lld, StackProbeType, Target, TargetMetadata, base};
+
+pub(crate) fn target() -> Target {
+    let mut base = base::veda::opts();
+    base.max_atomic_width = Some(128);
+    base.features = "+v8a,+outline-atomics".into();
+    base.stack_probes = StackProbeType::Inline;
+    base.linker = Some("aarch64-veda-gcc".into());
+    // Enable the Cortex-A53 errata 843419 mitigation by default
+    base.add_pre_link_args(LinkerFlavor::Gnu(Cc::Yes, Lld::No), &["-Wl,--fix-cortex-a53-843419"]);
+    // the AAPCS64 expects use of non-leaf frame pointers
+    base.frame_pointer = FramePointer::NonLeaf;
+
+    Target {
+        llvm_target: "aarch64-unknown-veda".into(),
+        metadata: TargetMetadata {
+            description: Some("ARM64 Veda".into()),
+            tier: None,
+            host_tools: Some(false),
+            std: Some(true),
+        },
+        pointer_width: 64,
+        data_layout:
+            "e-m:e-p270:32:32-p271:32:32-p272:64:64-i8:8:32-i16:16:32-i64:64-i128:128-n32:64-S128-Fn32"
+                .into(),
+        arch: Arch::AArch64,
+        options: base,
+    }
+}
