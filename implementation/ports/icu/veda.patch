--- a/source/common/putil.cpp
+++ b/source/common/putil.cpp
@@ -1158,6 +1158,35 @@
     /* else U_TZNAME will give a better result. */
 #endif
 
+#if defined(__veda__)
+    /* Veda keeps its time zone as an offset from UTC, with no rules of
+       daylight saving (the C library's, without TZ, is a POSIX string of
+       it, "<+02>-2", whose name is no zone's): the tz database's zone of
+       that offset alone, Etc/GMT-2 (whose sign, as POSIX's, is west of
+       UTC), or one of a region on that offset all year. */
+    if (getenv("TZ") == nullptr) {
+        static const struct { int32_t west; const char *id; } regions[] = {
+            { -330 * 60, "Asia/Kolkata" }, { -345 * 60, "Asia/Kathmandu" }, { -390 * 60, "Asia/Yangon" },
+            { -570 * 60, "Australia/Darwin" }, { -525 * 60, "Australia/Eucla" }, { -270 * 60, "Asia/Kabul" },
+            { -210 * 60, "Asia/Tehran" }, { 570 * 60, "Pacific/Marquesas" },
+        };
+        static char vedaZone[16];
+        int32_t west = uprv_timezone();
+        if (west == 0) {
+            return "Etc/UTC";
+        }
+        if (west % 3600 == 0 && west >= -14 * 3600 && west <= 12 * 3600) {
+            snprintf(vedaZone, sizeof vedaZone, "Etc/GMT%+d", (int)(west / 3600));
+            return vedaZone;
+        }
+        for (const auto &r : regions) {
+            if (r.west == west) {
+                return r.id;
+            }
+        }
+    }
+#endif
