+// The network process reads a page from the user's files (file://), and
+// reaches none of them but the engine's own until the browser, which it is
+// sandboxed from, lends it one: the folder of a page the user opens, which
+// holds what the page shows beside it (its pictures, styles, scripts, the
+// pages it links to), to read. The file system makes the loan, a secret
+// that only a process that is not sandboxed can have it make
+// (veda_lend_files), and the network process takes it (BorrowFiles,
+// veda_borrow_files): from then on it reaches that folder too, and nothing
+// else more. What lends is the embedder's own loading of a page
+// (webkit_web_view_load_uri, webkit_web_view_load_request: the address the
+// user typed, a bookmark, a file opened with the browser): a page's links,
+// scripts, redirects, windows and history lend nothing, so that no page
+// widens what the network process reaches. A folder that is the home
+// folder, or holds it, is never lent: a page there lends only itself.
+//
+// The browser takes a folder back (veda_take_back_files) once no page it
+// has open needs it: none shows a page from there, in its main frame or
+// another (an iframe), is loading one, or has one in its history (back and
+// forward, its frames' too). That is as its last tab closes, or its last
+// page leaves the history of its tab; the file system then takes the
+// folder out of what the network process reaches, which a compromised
+// network process could not keep. So the network process reaches the
+// folders of the pages still open, not every one opened since the browser
+// started. The embedder's reloading a page, or going back or forward to
+// one, lends its folder again if it was lent for its tab before (as loading
+// the page again does); a page's own history lends nothing.
+//
+// Within what the network process reaches, a web process has it read only
+// what was lent for its page (AllowFileAccessFromWebProcess; the network
+// process checks every file it reads for a web process,
+// NetworkConnectionToWebProcess::mayReadFile), and is allowed a place only
+// as it starts, before it has shown anything: a process that has shown a
+// page, from the web or from the user's files, gains no place after, and a
+// page from the user's files that its process was not allowed goes to a new
+// one (WebProcessPool's processForNavigationInternal). So no page reaches
+// what was lent after it was shown, nor what was lent for another, even in
+// the same tab, whatever the user then opens there. There is no "universal
+// file read" on Veda: a page's navigation to a file outside what was lent
+// for it, in its window or a new one, is refused.
+//
+// As a place is taken back, WebKit forgets it for every web process
+// (ForgetFiles): the network process reads it for none of them, and each
+// counts as never allowed it, so that a page there later goes to a new
+// process. So a process that was allowed a folder (a window that outlived
+// the page that opened it, in that page's process) does not have it read
+// when it is lent again, for another page. The UI process forgets it
+// too, in what it assumes each of them may read (forgetReadAccessToFiles,
+// which it checks the addresses a web process gives it against): such a
+// window's navigation there fails, saying so, as a page's to any file
+// outside what was lent for it does. (Else it would go to a new process,
+// allowed nothing there, which the UI process would end, as WebKit ends
+// one that gives the address of a file it may not read: the navigation
+// would end without a word.)
+//
+// Nor is a folder taken back from under a page of it that a frame still
+// shows or is about to load: the page's web process goes on giving the UI
+// process its address (as a script pushes a state or goes to a fragment,
+// or as a load of it ends late), which the UI process, the folder
+// forgotten, would take for that of a file the process may not read, and
+// end the process. So a window keeps as its own the places lent for the
+// page that opened it, as that page goes (in a frame the page put in it,
+// the window may go on showing a page of its folder), and a page let go to
+// a file is loading it from then on, for a while, before its web process
+// starts the load (at once): its folder is not taken back between the two.
+
+namespace WebKit {
+
+// A place lent: a path, absolute, normal and without a slash at its end,
+// and whether it is a folder.
+struct LentPlace {
+    String path;
+    bool isFolder { false };
+};
+
+// A loan of a place: the secret its lender takes it back with.
+using Loan = std::array<uint8_t, VEDA_LOAN_SIZE>;
+
+// `path` normal and without a slash at its end; null if it is not
+// absolute.
+static String normalPath(const String& path)
+{
+    if (!path.startsWith('/'))
+        return { };
+    auto normal = FileSystem::lexicallyNormal(path);
+    while (normal.length() > 1 && normal.endsWith('/'))
+        normal = normal.left(normal.length() - 1);
+    return normal;
+}
+
+// Whether `path` is `place` or inside it.
+static bool isInside(const String& path, const String& place)
+{
+    if (place == "/"_s)
+        return true;
+    return path == place || (path.length() > place.length() && path.startsWith(place) && path[place.length()] == '/');
+}
+
+// Whether `path` is the user's home folder or holds it.
+static bool holdsHome(const String& path)
+{
+    static NeverDestroyed<String> home = normalPath(String::fromUTF8(g_get_home_dir()));
+    return isInside("/home"_s, path) || (!home->isNull() && isInside(home, path));
+}
+
+// The path of the file of this machine at `url`; null if it is not one.
+static String filePath(const URL& url)
+{
+    if (!url.protocolIsFile() || !url.host().isEmpty())
+        return { };
+    return normalPath(url.fileSystemPath());
+}
+
+// What loading `url` lends: the folder of the page (a folder's own, for a
+// folder's listing), or the page alone where its folder is the home folder
+// or holds it. Nothing for what is not a file of this machine, or is the
+// home folder or holds it.
+static std::optional<LentPlace> placeToLend(const URL& url)
+{
+    auto path = filePath(url);
+    if (path.isNull())
+        return std::nullopt;
+    bool isFolder = url.path().endsWith('/') || FileSystem::fileType(path) == FileSystem::FileType::Directory;
+    auto folder = isFolder ? path : FileSystem::parentPath(path);
+    if (!holdsHome(folder))
+        return LentPlace { folder, true };
+    if (!holdsHome(path))
+        return LentPlace { path, isFolder };
+    return std::nullopt;
+}
+
+// The places lent for each page: those its embedder's loads lent, and
+// those of the pages that opened it, which it may outlast (it keeps them
+// as they go). A page keeps them, lent or taken back since.
+static WeakHashMap<WebPageProxy, Vector<LentPlace>>& lentForPage()
+{
+    static NeverDestroyed<WeakHashMap<WebPageProxy, Vector<LentPlace>>> places;
+    return places;
+}
+
+// The places each network process has lent now, and their loans.
+static WeakHashMap<NetworkProcessProxy, HashMap<String, Loan>>& lentToNetworkProcess()
+{
+    static NeverDestroyed<WeakHashMap<NetworkProcessProxy, HashMap<String, Loan>>> places;
+    return places;
+}
+
+// The places each web process was allowed.
+static WeakHashMap<WebProcessProxy, Vector<LentPlace>>& allowedToProcess()
+{
+    static NeverDestroyed<WeakHashMap<WebProcessProxy, Vector<LentPlace>>> places;
+    return places;
+}
+
+// The place `process` was allowed that holds `path`.
+static std::optional<LentPlace> allowedPlaceHolding(WebProcessProxy& process, const String& path)
+{
+    if (auto places = allowedToProcess().getOptional(process)) {
+        for (auto& place : *places) {
+            if (isInside(path, place.path))
+                return place;
+        }
+    }
+    return std::nullopt;
+}
+
+// Lends `networkProcess` the place `path` to read, unless it has it lent
+// already: whether it has it.
+static bool lendTo(NetworkProcessProxy& networkProcess, const String& path)
+{
+    auto& lent = lentToNetworkProcess().ensure(networkProcess, [] {
+        return HashMap<String, Loan> { };
+    }).iterator->value;
+    if (lent.contains(path))
+        return true;
+    Loan loan;
+    if (int error = veda_lend_files(FileSystem::fileSystemRepresentation(path).data(), loan.data())) {
+        WTFLogAlways("The network process cannot be lent %s: %s", path.utf8().data(), safeStrerror(error).data());
+        return false;
+    }
+    lent.add(path, loan);
+    networkProcess.send(Messages::NetworkProcess::BorrowFiles(path, Vector<uint8_t>(loan)), 0);
+    return true;
+}
+
+void WebProcessProxy::forgetReadAccessToFiles(const String& path)
+{
+    m_localPathsWithAssumedReadAccess.removeIf([&](auto& assumed) {
+        return normalPath(assumed) == path;
+    });
+}
+
+// Takes the place `path`, lent with `loan`, back from `networkProcess`,
+// which reaches it no more, and forgets it for every web process it reads
+// for: it reads the place for none of them, and each counts as never
+// allowed it, even once the place is lent again; nor does the UI process
+// assume any of them reads it.
+static void takeBack(NetworkProcessProxy& networkProcess, const String& path, const Loan& loan)
+{
+    if (int error = veda_take_back_files(loan.data()))
+        WTFLogAlways("%s cannot be taken back from the network process: %s", path.utf8().data(), safeStrerror(error).data());
+    networkProcess.send(Messages::NetworkProcess::ForgetFiles(path), 0);
+    for (auto entry : allowedToProcess()) {
+        RefPtr dataStore = entry.key.websiteDataStore();
+        if (dataStore && dataStore->networkProcessIfExists() == &networkProcess)
+            entry.value.removeAllMatching([&](auto& place) { return place.path == path; });
+    }
+    for (auto& pool : WebProcessPool::allProcessPools()) {
+        for (auto& process : pool->processes()) {
+            RefPtr dataStore = process->websiteDataStore();
+            if (dataStore && dataStore->networkProcessIfExists() == &networkProcess)
+                process->forgetReadAccessToFiles(path);
+        }
+    }
+}
+
+// Keeps `place` among the places lent for `page`.
+static void keepForPage(WebPageProxy& page, const LentPlace& place)
+{
+    auto& places = lentForPage().ensure(page, [] {
+        return Vector<LentPlace> { };
+    }).iterator->value;
+    if (!places.containsIf([&](auto& lent) { return lent.path == place.path; }))
+        places.append(place);
+}
+
+void lendFilesForLoad(WebPageProxy& page, const URL& url)
+{
+    auto place = placeToLend(url);
+    if (!place || !lendTo(protect(page.websiteDataStore().networkProcess()).get(), place->path))
+        return;
+    keepForPage(page, *place);
+    // The page may navigate there (the UI process's own check of the
+    // addresses a web process gives it).
+    page.addPreviouslyVisitedPath(place->isFolder ? makeString(place->path, '/') : place->path);
+}
+
+// The places lent for `page` and for the pages that opened it
+// (window.open, a link opened in another tab), which it may load its pages
+// in: its own first.
+static Vector<LentPlace> placesLentFor(WebPageProxy& page)
+{
+    Vector<LentPlace> places;
+    HashSet<WebPageProxy*> seen;
+    for (RefPtr current = &page; current && seen.add(current.get()).isNewEntry; current = current->configuration().relatedPage()) {
+        if (auto lent = lentForPage().getOptional(*current))
+            places.appendVector(WTF::move(*lent));
+    }
+    return places;
+}
+
+// Whether the network process of `page` has `place` lent now.
+static bool isLentNow(WebPageProxy& page, const LentPlace& place)
+{
+    RefPtr networkProcess = page.websiteDataStore().networkProcessIfExists();
+    if (!networkProcess)
+        return false;
+    auto lent = lentToNetworkProcess().find(*networkProcess);
+    return lent != lentToNetworkProcess().end() && lent->value.contains(place.path);
+}
+
+// The place lent now for `page`, or a page that opened it, that holds
+// `path`.
+static std::optional<LentPlace> lentPlaceHolding(WebPageProxy& page, const String& path)
+{
+    for (auto& place : placesLentFor(page)) {
+        if (isInside(path, place.path) && isLentNow(page, place))
+            return place;
+    }
+    return std::nullopt;
+}
+
+// A file a page was let go to (a navigation decided), and until when it
+// counts as loading it, its web process not having started the load.
+struct DecidedFile {
+    String path;
+    MonotonicTime until;
+};
+
+// How long that is: the web process starts the load at once, as it is told
+// it may.
+static constexpr Seconds decidedLoadTime = 10_s;
+
+// The files each page was let go to.
+static WeakHashMap<WebPageProxy, Vector<DecidedFile>>& filesDecided()
+{
+    static NeverDestroyed<WeakHashMap<WebPageProxy, Vector<DecidedFile>>> files;
+    return files;
+}
+
+// Adds the addresses that `item`, a frame's in a page's history, and its
+// frames' hold.
+static void addAddresses(const WebBackForwardListFrameItem& item, Vector<URL>& urls)
+{
+    urls.append(URL { item.frameState().urlString });
+    urls.append(URL { item.frameState().originalURLString });
+    for (auto& child : item.children())
+        addAddresses(child, urls);
+}
+
+// The files of this machine that `page` shows, is loading, or has in its
+// history (back and forward), in any of its frames: their paths.
+static Vector<String> filesOf(WebPageProxy& page)
+{
+    auto& state = page.pageLoadState();
+    Vector<URL> urls { state.pendingAPIRequestURL(), state.provisionalURL(), state.url(), state.unreachableURL() };
+    // Every frame's: the main frame's, and those of the frames within it.
+    for (RefPtr frame = page.mainFrame(); frame; frame = frame->traverseNext().frame) {
+        urls.append(frame->url());
+        urls.append(frame->provisionalURL());
+        urls.append(frame->unreachableURL());
+    }
+    // Every item of its history, none skipped, with its frames'.
+    auto& history = page.backForwardList();
+    for (int delta = 0; RefPtr item = history.itemAtDeltaFromCurrentIndex(delta, AllowSkippingBackForwardItems::No); --delta)
+        addAddresses(item->mainFrameItem(), urls);
+    for (int delta = 1; RefPtr item = history.itemAtDeltaFromCurrentIndex(delta, AllowSkippingBackForwardItems::No); ++delta)
+        addAddresses(item->mainFrameItem(), urls);
+    Vector<String> files;
+    for (auto& url : urls) {
+        if (auto path = filePath(url); !path.isNull() && !files.contains(path))
+            files.append(WTF::move(path));
+    }
+    // And those it was let go to, whose loads have not started.
+    if (auto decided = filesDecided().find(page); decided != filesDecided().end()) {
+        auto now = MonotonicTime::now();
+        decided->value.removeAllMatching([&](auto& file) { return file.until <= now; });
+        for (auto& file : decided->value) {
+            if (!files.contains(file.path))
+                files.append(file.path);
+        }
+    }
+    return files;
+}
+
+// The places lent for `page`, or for a page that opened it, that it needs:
+// those that hold a page it shows, is loading, or has in its history. None
+// once it is closed.
+static Vector<LentPlace> placesNeededBy(WebPageProxy& page)
+{
+    if (page.isClosed())
+        return { };
+    auto files = filesOf(page);
+    Vector<LentPlace> needed;
+    for (auto& place : placesLentFor(page)) {
+        if (needed.containsIf([&](auto& other) { return other.path == place.path; }))
+            continue;
+        if (files.containsIf([&](auto& file) { return isInside(file, place.path); }))
+            needed.append(place);
+    }
+    return needed;
+}
+
+// The pages open, once each: those places were lent for, and those of
+// every web process (a window a page opened, which may need what was lent
+// for the page).
+static Vector<Ref<WebPageProxy>> pagesOpen()
+{
+    Vector<Ref<WebPageProxy>> pages;
+    HashSet<WebPageProxy*> seen;
+    auto add = [&](WebPageProxy& page) {
+        if (!page.isClosed() && seen.add(&page).isNewEntry)
+            pages.append(Ref<WebPageProxy> { page });
+    };
+    for (auto entry : lentForPage())
+        add(entry.key);
+    for (auto& pool : WebProcessPool::allProcessPools()) {
+        for (auto& process : pool->processes()) {
+            for (auto& page : process->pages())
+                add(page);
+        }
+    }
+    return pages;
+}
+
+// Takes back from each network process what no page that it loads for
+// needs any more.
+static void takeBackWhatNoPageNeeds()
+{
+    auto pages = pagesOpen();
+    Vector<Ref<NetworkProcessProxy>> networkProcesses;
+    for (auto entry : lentToNetworkProcess())
+        networkProcesses.append(Ref<NetworkProcessProxy> { entry.key });
+    for (auto& networkProcess : networkProcesses) {
+        HashSet<String> needed;
+        for (auto& page : pages) {
+            if (page->websiteDataStore().networkProcessIfExists() != networkProcess.ptr())
+                continue;
+            for (auto& place : placesNeededBy(page))
+                needed.add(place.path);
+        }
+        auto lent = lentToNetworkProcess().find(networkProcess.get());
+        if (lent == lentToNetworkProcess().end())
+            continue;
+        auto& loans = lent->value;
+        Vector<String> unneeded;
+        for (auto& path : loans.keys()) {
+            if (!needed.contains(path))
+                unneeded.append(path);
+        }
+        for (auto& path : unneeded)
+            takeBack(networkProcess.get(), path, loans.take(path));
+    }
+}
+
+// Whether takeBackWhatNoPageNeeds is due to run (takeBackFilesSoon).
+static bool takingBackIsDue;
+
+void takeBackFilesSoon()
+{
+    if (lentToNetworkProcess().isEmptyIgnoringNullReferences())
+        return;
+    // Each page open keeps as its own the places lent for the pages that
+    // opened it, at once: one of them may be gone by then (a tab closing),
+    // and with it what it was lent.
+    for (auto& page : pagesOpen()) {
+        for (auto& place : placesLentFor(page))
+            keepForPage(page, place);
+    }
+    if (takingBackIsDue)
+        return;
+    takingBackIsDue = true;
+    RunLoop::currentSingleton().dispatch([] {
+        takingBackIsDue = false;
+        takeBackWhatNoPageNeeds();
+    });
+}
+
+void navigationDecided(WebPageProxy& page, const URL& url)
+{
+    auto path = filePath(url);
+    if (path.isNull())
+        return;
+    filesDecided().ensure(page, [] {
+        return Vector<DecidedFile> { };
+    }).iterator->value.append({ WTF::move(path), MonotonicTime::now() + decidedLoadTime });
+    // Once that no longer counts, what no page needs is taken back.
+    RunLoop::currentSingleton().dispatchAfter(decidedLoadTime, [] {
+        takeBackFilesSoon();
+    });
+}
+
+void lendFilesNeeded(NetworkProcessProxy& networkProcess)
+{
+    for (auto& page : pagesOpen()) {
+        for (auto& place : placesNeededBy(page))
+            lendTo(networkProcess, place.path);
+    }
+}
+
+// Lends the network process of `page` again the place lent for it, or for
+// a page that opened it, that holds `url`, if it was taken back.
+static void lendAgain(WebPageProxy& page, const URL& url)
+{
+    auto path = filePath(url);
+    if (path.isNull())
+        return;
+    for (auto& place : placesLentFor(page)) {
+        if (isInside(path, place.path)) {
+            lendTo(protect(page.websiteDataStore().networkProcess()).get(), place.path);
+            return;
+        }
+    }
+}
+
+void lendFilesAgain(WebPageProxy& page, HistoryMove move)
+{
+    RefPtr<WebBackForwardListItem> item;
+    switch (move) {
+    case HistoryMove::Reload:
+        return lendAgain(page, URL { page.currentURL() });
+    case HistoryMove::Back:
+        item = page.backForwardList().goBackItemSkippingItemsWithoutUserGesture();
+        break;
+    case HistoryMove::Forward:
+        item = page.backForwardList().goForwardItemSkippingItemsWithoutUserGesture();
+        break;
+    }
+    if (item)
+        lendAgain(page, URL { item->url() });
+}
+
+void lendFilesAgain(WebPageProxy& page, WebBackForwardListItem& item)
+{
+    lendAgain(page, URL { item.url() });
+}
+
+bool mayHaveFileRead(WebProcessProxy& process, const URL& url)
+{
+    auto path = normalPath(url.fileSystemPath());
+    return !path.isNull() && allowedPlaceHolding(process, path);
+}
+
+// Instead of a sandbox extension, which Veda has not: a web process that
+// loads a page from the user's files is allowed, in the network process,
+// the place lent now for the page that holds it, if it has shown nothing
+// yet; one that has is allowed again only the places it was and that were
+// not taken back since (for a network process that started after the one
+// that allowed them). Nothing else of the user's: what was lent for no
+// page of its, or after it showed a page, the network process does not
+// read for it.
+void WebPageProxy::maybeInitializeSandboxExtensionHandle(WebProcessProxy& process, const URL& url, const URL&, bool, CompletionHandler<void(std::optional<SandboxExtension::Handle>&&)>&& completionHandler)
+{
+    auto done = [completionHandler = WTF::move(completionHandler)] mutable {
+        completionHandler(std::nullopt);
+    };
+    auto path = url.protocolIsFile() ? normalPath(url.fileSystemPath()) : String();
+    if (path.isNull())
+        return done();
+    auto place = allowedPlaceHolding(process, path);
+    if (!place && !process.hasCommittedAnyProvisionalLoads()) {
+        place = lentPlaceHolding(*this, path);
+        if (place) {
+            allowedToProcess().ensure(process, [] {
+                return Vector<LentPlace> { };
+            }).iterator->value.append(*place);
+        }
+    }
+    if (!place)
+        return done();
+    if (place->isFolder)
+        return process.assumeReadAccessToBaseURL(*this, URL::fileURLWithFileSystemPath(makeString(place->path, '/')).string(), WTF::move(done));
+    RefPtr dataStore = process.websiteDataStore();
+    if (!dataStore)
+        return done();
+    protect(dataStore->networkProcess())->sendWithAsyncReply(Messages::NetworkProcess::AllowFileAccessFromWebProcess(process.coreProcessIdentifier(), place->path, std::nullopt), WTF::move(done));
+}
+
+} // namespace WebKit
+
