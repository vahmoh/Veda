+
+namespace WebKit {
+
+// The places of the user's files the embedder gives the network process
+// (WEBKIT_VEDA_NETWORK_PROCESS_FILES, absolute paths separated by ':'),
+// each to read and change.
+static Vector<String> namedPlaces()
+{
+    Vector<String> places;
+    for (auto& path : String::fromUTF8(getenv("WEBKIT_VEDA_NETWORK_PROCESS_FILES")).split(':')) {
+        if (!path.startsWith('/'))
+            continue;
+        auto place = FileSystem::lexicallyNormal(path);
+        while (place.length() > 1 && place.endsWith('/'))
+            place = place.left(place.length() - 1);
+        places.append(WTF::move(place));
+    }
+    return places;
+}
+
+// Whether `path` is `place`, or inside it.
+static bool isInside(const String& path, const String& place)
+{
+    return path == place || path.startsWith(makeString(place, '/'));
+}
+
+// Something of the file system beside `places`, in a directory on the way
+// to one of them: what the sandbox is to hide, which its check looks for.
+// The user's files (/home) are looked in first, and directories before
+// those inside them. Null if there is nothing beside them.
+static String besidePlaces(const Vector<String>& places)
+{
+    Vector<String> directories;
+    for (auto& place : places) {
+        for (auto directory = FileSystem::parentPath(place); directory.length() > 1; directory = FileSystem::parentPath(directory)) {
+            if (!directories.contains(directory))
+                directories.append(directory);
+        }
+    }
+    std::ranges::stable_sort(directories, [](auto& a, auto& b) {
+        bool aHome = isInside(a, "/home"_s);
+        if (aHome != isInside(b, "/home"_s))
+            return aHome;
+        return a.length() < b.length();
+    });
+    for (auto& directory : directories) {
+        for (auto& name : FileSystem::listDirectory(directory)) {
+            auto path = FileSystem::pathByAppendingComponent(directory, name);
+            bool left = std::ranges::any_of(places, [&](auto& place) {
+                return isInside(path, place) || isInside(place, path);
+            });
+            if (!left)
+                return path;
+        }
+    }
+    return { };
+}
+
+// What of the sandbox does not hold, if anything: `beside`, which was
+// there beside its places, still is; it reaches the file system's service,
+// where a connection of its own would have all the files; or it starts
+// processes.
+static const char* sandboxHole(const String& beside)
+{
+    if (!beside.isNull() && (!access(FileSystem::fileSystemRepresentation(beside).data(), F_OK) || errno != ENOENT))
+        return "what is beside its places is there";
+    veda_handle_t channel;
+    if (!veda_service_connect("vfs", &channel)) {
+        veda_close(channel);
+        return "it reaches the file system's service";
+    }
+    // The program again, which would end at once: it is no process of
+    // WebKit's of that type.
+    CString program = FileSystem::currentExecutablePath();
+    char* arguments[] = { const_cast<char*>(program.data()), nullptr };
+    char* environment[] = { const_cast<char*>("WEBKIT_PROCESS_TYPE=none"), nullptr };
+    pid_t child;
+    int spawned = posix_spawn(&child, program.data(), nullptr, nullptr, arguments, environment);
+    if (!spawned)
+        waitpid(child, nullptr, 0);
+    if (spawned != EACCES)
+        return "it starts processes";
+    return nullptr;
+}
+
+// The network process keeps, of what it was started with:
+//
+// - Files: the system image (the program, ICU's data, the certificate
+//   authorities TLS trusts) and the devices, to read; /dev/null to write;
+//   and the places of the user's files the embedder names in
+//   WEBKIT_VEDA_NETWORK_PROCESS_FILES, to read and change. The browser
+//   names the engine's data and cache (what webkit_network_session_new
+//   is given: cookies, storage, the cache), the downloads, and its
+//   temporary files, where the network process keeps its own (TMPDIR)
+//   and the browser copies the files the user chooses for a page to
+//   upload. Nothing else, but the folders of the pages the user opens
+//   (file://), which the UI process lends it to read while a page needs
+//   them (borrowFiles, NetworkFileLoansVeda.cpp).
+// - Services: the network's (sockets, names), and no other: not the file
+//   system's (its connection to it is the one confined), not the
+//   launcher.
+// - The kernel: no processes, no kernel log, and no new executable memory:
+//   it runs no script (proxies come from the environment, never from a
+//   PAC script).
+//
+// It first makes the way to each place (the directories it is in), as the
+// sandbox lets it make a place, but nothing on the way to one. It checks
+// that what it gave up is gone before it goes on, and goes no further if
+// it is not. As on Linux, WEBKIT_DISABLE_SANDBOX_THIS_IS_DANGEROUS leaves
+// it all.
+void NetworkProcess::initializeSandbox(const AuxiliaryProcessInitializationParameters&, SandboxInitializationParameters&)
+{
+    if (getenv("WEBKIT_DISABLE_SANDBOX_THIS_IS_DANGEROUS")) {
+        WTFLogAlways("Network process %d is not sandboxed (WEBKIT_DISABLE_SANDBOX_THIS_IS_DANGEROUS)", getpid());
+        return;
+    }
+    auto named = namedPlaces();
+    Vector<CString> paths;
+    for (auto& place : named) {
+        FileSystem::makeAllDirectories(FileSystem::parentPath(place));
+        paths.append(FileSystem::fileSystemRepresentation(place));
+    }
+    Vector<struct veda_place> files {
+        { "/system", 0 },
+        { "/dev", 0 },
+        { "/dev/null", 1 },
+    };
+    for (auto& path : paths)
+        files.append(veda_place { path.data(), 1 });
+    Vector<String> places { "/system"_s, "/dev"_s };
+    places.appendVector(named);
+    String beside = besidePlaces(places);
+    static const char* const services[] = { "net" };
+    int error = veda_confine_files(files.span().data(), files.size());
+    if (!error)
+        error = veda_confine_services(services, std::size(services));
+    if (!error)
+        error = veda_process_restrict(VEDA_RESTRICT_LOG | VEDA_RESTRICT_PROCESSES | VEDA_RESTRICT_EXECUTE);
+    if (error) {
+        WTFLogAlways("Network process %d cannot sandbox itself: %s", getpid(), safeStrerror(error).data());
+        CRASH();
+    }
+    if (auto* hole = sandboxHole(beside)) {
+        WTFLogAlways("Network process %d: its sandbox does not hold: %s", getpid(), hole);
+        CRASH();
+    }
+    if (named.isEmpty())
+        WTFLogAlways("Network process %d is sandboxed: it reads only the system image and the devices, changes none of the user's files, reaches only the network service, and cannot start processes or make memory executable", getpid());
+    else
+        WTFLogAlways("Network process %d is sandboxed: it reads only the system image and the devices, and reads and changes only %s; it reaches only the network service, and cannot start processes or make memory executable", getpid(), makeStringByJoining(named.span(), ", "_s).utf8().data());
+}
