+namespace WebKit {
+
+// What of the sandbox does not hold, if anything: the user's files are
+// there, the process has a socket of its own, or it starts processes.
+static const char* sandboxHole()
+{
+    if (!access("/home", F_OK) || errno != ENOENT)
+        return "the user's files are there";
+    // A UDP socket's connect binds it, which the network service does; it
+    // sends nothing.
+    int socketDescriptor = socket(AF_INET, SOCK_DGRAM | SOCK_CLOEXEC, 0);
+    if (socketDescriptor >= 0) {
+        struct sockaddr_in address { };
+        address.sin_family = AF_INET;
+        address.sin_port = htons(9);
+        address.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+        int connected = connect(socketDescriptor, reinterpret_cast<struct sockaddr*>(&address), sizeof(address));
+        int error = errno;
+        close(socketDescriptor);
+        if (!connected || error != EACCES)
+            return "it has a socket of its own";
+    }
+    // The program again, which would end at once: it is no process of
+    // WebKit's of that type.
+    CString program = FileSystem::currentExecutablePath();
+    char* arguments[] = { const_cast<char*>(program.data()), nullptr };
+    char* environment[] = { const_cast<char*>("WEBKIT_PROCESS_TYPE=none"), nullptr };
+    pid_t child;
+    int spawned = posix_spawn(&child, program.data(), nullptr, nullptr, arguments, environment);
+    if (!spawned)
+        waitpid(child, nullptr, 0);
+    if (spawned != EACCES)
+        return "it starts processes";
+    return nullptr;
+}
+
+// A page's process keeps, of what it was started with:
+//
+// - Files: the system image (fonts and fontconfig's configuration, the
+//   program), fontconfig's cache, which the UI process makes, and the
+//   devices, to read; /dev/null to write. Nothing of the user's.
+// - Services: those the embedder's own code in the process reaches, which
+//   it names in WEBKIT_VEDA_WEB_PROCESS_SERVICES ("gpu,audio": the GPU's,
+//   which pages composited with OpenGL ES need, and the audio service,
+//   which its media sink plays through), and no other: not the network's
+//   (the network process fetches; the web process has no sockets), not the
+//   file system's (its connection to it is the one confined), not the
+//   launcher.
+// - The kernel: no processes, no kernel log, and no new executable memory.
+//   JavaScriptCore's JIT goes on: its pool of executable memory, readable,
+//   writable and executable, was reserved as JavaScriptCore was initialized
+//   (ExecutableAllocator, in InitializeWebKit2), and its code goes there.
+//
+// It checks that what it gave up is gone before it goes on, and goes no
+// further if it is not. As on Linux, WEBKIT_DISABLE_SANDBOX_THIS_IS_DANGEROUS
+// leaves it all.
+void WebProcess::initializeSandbox(const AuxiliaryProcessInitializationParameters&, SandboxInitializationParameters&)
+{
+    if (getenv("WEBKIT_DISABLE_SANDBOX_THIS_IS_DANGEROUS")) {
+        WTFLogAlways("Web process %d is not sandboxed (WEBKIT_DISABLE_SANDBOX_THIS_IS_DANGEROUS)", getpid());
+        return;
+    }
+    static const struct veda_place files[] = {
+        { "/system", 0 },
+        { "/tmp/fontconfig", 0 },
+        { "/dev", 0 },
+        { "/dev/null", 1 },
+    };
+    String named = String::fromUTF8(getenv("WEBKIT_VEDA_WEB_PROCESS_SERVICES"));
+    Vector<CString> services;
+    for (auto& name : named.split(','))
+        services.append(name.utf8());
+    Vector<const char*> names;
+    for (auto& name : services)
+        names.append(name.data());
+    int error = veda_confine_files(files, std::size(files));
+    if (!error)
+        error = veda_confine_services(names.span().data(), names.size());
+    if (!error)
+        error = veda_process_restrict(VEDA_RESTRICT_LOG | VEDA_RESTRICT_PROCESSES | VEDA_RESTRICT_EXECUTE);
+    if (error) {
+        WTFLogAlways("Web process %d cannot sandbox itself: %s", getpid(), safeStrerror(error).data());
+        CRASH();
+    }
+    if (auto* hole = sandboxHole()) {
+        WTFLogAlways("Web process %d: its sandbox does not hold: %s", getpid(), hole);
+        CRASH();
+    }
+    if (names.isEmpty())
+        WTFLogAlways("Web process %d is sandboxed: it reads only the system image, fontconfig's cache and the devices, reaches no service, and cannot start processes, open sockets or make memory executable", getpid());
+    else
+        WTFLogAlways("Web process %d is sandboxed: it reads only the system image, fontconfig's cache and the devices, reaches only the services %s, and cannot start processes, open sockets or make memory executable", getpid(), named.utf8().data());
