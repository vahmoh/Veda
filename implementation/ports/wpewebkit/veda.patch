+// The entry point of WebKit's processes on Veda, where they are the
+// program that embeds WebKit started again: the embedder's main() calls
+// it first, and returns what it returns unless it is -1 (the program is
+// not one of WebKit's processes). The launcher says which process the
+// program is to be with WEBKIT_PROCESS_TYPE, which goes no further.
+extern "C" WK_EXPORT int webkit_veda_auxiliary_process_main(int argc, char** argv)
+{
+    const char* type = getenv("WEBKIT_PROCESS_TYPE");
+    if (!type)
+        return -1;
+    int (*processMain)(int, char**) = nullptr;
+    if (!strcmp(type, "WebProcess"))
+        processMain = WebKit::WebProcessMain;
+    else if (!strcmp(type, "NetworkProcess"))
+        processMain = WebKit::NetworkProcessMain;
+#if ENABLE(GPU_PROCESS)
+    else if (!strcmp(type, "GPUProcess"))
+        processMain = WebKit::GPUProcessMain;
+#endif
+    unsetenv("WEBKIT_PROCESS_TYPE");
+    if (!processMain)
+        return EXIT_FAILURE;
+    return processMain(argc, argv);
+}
