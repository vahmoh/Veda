+#include <wtf/text/CString.h>
+
+// Pages from the user's files, in the network process (the UI process's
+// side: UIProcess/veda/FileLoansVeda.cpp). The network process reaches a
+// folder of the user's once the UI process lends it (borrowFiles), until
+// the UI process takes it back, through the file system, once no page
+// needs it; and it reads for a web process only what the UI process
+// allowed that web process (mayReadFile): the places lent for its page,
+// the files chosen for it to upload, its own temporary files. A place
+// taken back it forgets for every web process (forgetFiles), so that none
+// has it read once it is lent again, for another page.
+
+namespace WebKit {
+
+void NetworkProcess::borrowFiles(const String& path, const Vector<uint8_t>& loan)
+{
+    if (loan.size() != VEDA_LOAN_SIZE)
+        return;
+    if (int error = veda_borrow_files(FileSystem::fileSystemRepresentation(path).data(), loan.span().data()))
+        WTFLogAlways("Network process %d cannot borrow %s: %s", getpid(), path.utf8().data(), safeStrerror(error).data());
+}
+
+// What the UI process allowed web processes that have not connected yet:
+// their connections are allowed it as they come.
+static HashMap<WebCore::ProcessIdentifier, Vector<String>>& allowedBeforeConnecting()
+{
+    static NeverDestroyed<HashMap<WebCore::ProcessIdentifier, Vector<String>>> paths;
+    return paths;
+}
+
+void NetworkProcess::allowFileAccessBeforeConnecting(WebCore::ProcessIdentifier processIdentifier, const String& path)
+{
+    allowedBeforeConnecting().ensure(processIdentifier, [] {
+        return Vector<String> { };
+    }).iterator->value.append(path);
+}
+
+Vector<String> NetworkProcess::takeFileAccessAllowedBeforeConnecting(WebCore::ProcessIdentifier processIdentifier)
+{
+    return allowedBeforeConnecting().take(processIdentifier);
+}
+
+// `path` normal and without a slash at its end; null if it is not
+// absolute.
+static String normalPath(const String& path)
+{
+    if (!path.startsWith('/'))
+        return { };
+    auto normal = FileSystem::lexicallyNormal(path);
+    while (normal.length() > 1 && normal.endsWith('/'))
+        normal = normal.left(normal.length() - 1);
+    return normal;
+}
+
+void NetworkProcess::forgetFiles(const String& path)
+{
+    auto place = normalPath(path);
+    if (place.isNull())
+        return;
+    for (auto& connection : m_webProcessConnections.values())
+        connection->forgetAccessToFile(place);
+    for (auto& paths : allowedBeforeConnecting().values())
+        paths.removeAllMatching([&](auto& allowed) { return normalPath(allowed) == place; });
+}
+
+void NetworkConnectionToWebProcess::forgetAccessToFile(const String& path)
+{
+    auto place = normalPath(path);
+    if (place.isNull())
+        return;
+    m_allowedFilePaths.removeIf([&](auto& allowed) { return normalPath(allowed) == place; });
+}
+
+// The first few files refused to web processes are logged, as the file
+// system logs a sandboxed program's first few refusals.
+static constexpr unsigned loggedRefusals = 16;
+
+bool NetworkConnectionToWebProcess::mayReadFile(const String& path) const
+{
+    auto file = normalPath(path);
+    if (!file.isNull()) {
+        for (auto& allowed : m_allowedFilePaths) {
+            auto place = normalPath(allowed);
+            if (!place.isNull() && (file == place || FileSystem::isAncestor(place, file)))
+                return true;
+        }
+    }
+    static unsigned refusals;
+    if (++refusals <= loggedRefusals)
+        WTFLogAlways("Network process %d: web process %" PRIu64 " was refused %s: it was lent for no page of its", getpid(), m_webProcessIdentifier.toUInt64(), path.utf8().data());
+    return false;
+}
