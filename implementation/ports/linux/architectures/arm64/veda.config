# Linux for Veda's driver VM on ARM64 (AArch64): the options of arm64's and
# of its devices, beside every architecture's
# (implementation/ports/linux/veda.config). The platform's processors have a
# GICv3 and the architecture's timer, which arm64 always has, and start
# through PSCI.
CONFIG_ARM64_4K_PAGES=y
CONFIG_ARM64_VA_BITS_48=y
CONFIG_VEDA_GUEST=y
CONFIG_PCI_VEDA=y

# What would need more of the hypervisor than it gives: registers it does
# not switch between guests and the host.
CONFIG_ARM64_PTR_AUTH=n
CONFIG_ARM64_SVE=n
CONFIG_ARM64_SME=n
CONFIG_ARM64_MTE=n
CONFIG_ARM64_AMU_EXTN=n
CONFIG_ARM64_POE=n
CONFIG_ARM64_GCS=n

# The kernel at the address it was built for.
CONFIG_RANDOMIZE_BASE=n
