--- /dev/null
+++ b/drivers/virt/veda/bridge.c
@@ -0,0 +1,1102 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * /dev/veda: the bridge of Veda's driver VM, through which the programs of
+ * Linux in it use Veda's IPC (include/uapi/linux/veda.h).
+ *
+ * Each ioctl becomes the bridge's hypercall with the same request, copied
+ * into the kernel once (and used from that copy only), its buffers named by
+ * their guest-physical addresses. A file keeps the handles it made or was
+ * given, uses no others, and closes those it still holds when it is
+ * released: a program that dies leaves nothing behind in Veda. A wait the
+ * monitor cannot finish at once finishes through the notification ring,
+ * which the monitor announces with the hypervisor callback vector.
+ *
+ * A VMO is mapped by the monitor into guest-physical memory beyond RAM;
+ * the program maps those pages (mmap at the offset VEDA_IOC_VMO_MAP gives).
+ *
+ * A watch (VEDA_IOC_WATCH) is a file that is readable while a handle's
+ * signals are: a wait the monitor finishes later, made again as the file
+ * is polled after it was read. Programs poll Veda's objects with their
+ * other files so.
+ *
+ * A VMO's dma-buf (VEDA_IOC_VMO_DMABUF) gives Linux's drivers Veda's
+ * memory: the monitor maps the VMO as for a program, and the dma-buf hands
+ * its guest-physical range to importers, as addresses for their devices'
+ * DMA (the IOMMU sees the guest's memory as its processors do) or mapped
+ * for the processor. The range is unmapped when the dma-buf goes.
+ */
+
+#include <linux/anon_inodes.h>
+#include <linux/atomic.h>
+#include <linux/dma-buf.h>
+#include <linux/dma-mapping.h>
+#include <linux/file.h>
+#include <linux/io.h>
+#include <linux/fs.h>
+#include <linux/init.h>
+#include <linux/list.h>
+#include <linux/miscdevice.h>
+#include <linux/mm.h>
+#include <linux/mutex.h>
+#include <linux/poll.h>
+#include <linux/scatterlist.h>
+#include <linux/slab.h>
+#include <linux/spinlock.h>
+#include <linux/uaccess.h>
+#include <linux/wait.h>
+#include <linux/xarray.h>
+#include <asm/veda_para.h>
+#include <uapi/linux/veda.h>
+
+/* Operations (implementation/libraries/hv/src/bridge.rs: op): the
+ * ioctls' numbers, and the driver's own. */
+#define OP_SETUP	1
+#define OP_WAIT		6
+#define OP_CANCEL	7
+#define OP_VMO_MAP	16
+#define OP_VMO_UNMAP	17
+
+#define VEDA_PENDING	0xFFFFFFFFu
+/* The Veda error the driver answers with itself (vabi::Error). */
+#define VEDA_BAD_HANDLE	2
+
+#define MAX_BYTES	(64 * 1024)
+#define MAX_HANDLES	64
+#define MAX_WAIT_ITEMS	1024
+#define MAX_COPY	(64 * 1024)
+
+/* The notification ring: one page
+ * (implementation/libraries/hv/src/bridge.rs: ring). */
+#define RING_HEAD	0
+#define RING_TAIL	64
+#define RING_ENTRIES	128
+
+struct setup {
+	u32 status;
+	u32 vector;
+	u64 ring;
+};
+
+struct cancel {
+	u32 status;
+	u32 reserved;
+	u64 key;
+};
+
+struct ring_entry {
+	u64 key;
+	u32 status;
+	u32 satisfied;
+};
+
+#define RING_CAPACITY	((PAGE_SIZE - RING_ENTRIES) / sizeof(struct ring_entry))
+
+/* A wait the monitor finishes later. */
+struct waiter {
+	struct list_head node;
+	u64 key;
+	bool done;
+	u32 status;
+	u32 satisfied;
+};
+
+/* A VMO the monitor mapped for a file. */
+struct mapping {
+	struct list_head node;
+	struct bridge_file *file;
+	u64 gpa;
+	u64 len;
+	u32 flags;
+	bool mapped;
+};
+
+struct bridge_file {
+	/* The handles the file holds. */
+	struct xarray handles;
+	/* Its mappings; taken within mmap_lock (by mmap and munmap), so never
+	 * held while touching the program's memory. */
+	struct mutex mappings_lock;
+	struct list_head mappings;
+};
+
+static void *ring;
+static u32 ring_tail;
+static DEFINE_SPINLOCK(waiters_lock);
+static LIST_HEAD(waiters);
+static DECLARE_WAIT_QUEUE_HEAD(waiters_queue);
+static atomic64_t next_key;
+
+/* Carries out operation op with the request at req (kernel memory). */
+static int bridge_call(u32 op, void *req)
+{
+	return veda_hypercall(VEDA_HC_BRIDGE, op, __pa(req), 0, 0, 0) ? -EIO : 0;
+}
+
+/* The monitor finished waits: their completions are in the ring. */
+static void bridge_callback(void)
+{
+	u32 head = READ_ONCE(*(u32 *)(ring + RING_HEAD));
+	unsigned long flags;
+
+	spin_lock_irqsave(&waiters_lock, flags);
+	while (ring_tail != head) {
+		struct ring_entry e;
+		struct waiter *w;
+
+		memcpy(&e, ring + RING_ENTRIES + (ring_tail % RING_CAPACITY) * sizeof(e), sizeof(e));
+		ring_tail++;
+		list_for_each_entry(w, &waiters, node) {
+			if (w->key == e.key) {
+				w->status = e.status;
+				w->satisfied = e.satisfied;
+				WRITE_ONCE(w->done, true);
+				break;
+			}
+		}
+	}
+	WRITE_ONCE(*(u32 *)(ring + RING_TAIL), ring_tail);
+	spin_unlock_irqrestore(&waiters_lock, flags);
+	wake_up_all(&waiters_queue);
+}
+
+static bool holds(struct bridge_file *f, u32 handle)
+{
+	return handle && xa_load(&f->handles, handle);
+}
+
+static void keep(struct bridge_file *f, u32 handle)
+{
+	if (handle)
+		xa_store(&f->handles, handle, xa_mk_value(1), GFP_KERNEL);
+}
+
+static void forget(struct bridge_file *f, u32 handle)
+{
+	xa_erase(&f->handles, handle);
+}
+
+/* The status and handle that start most requests. */
+struct head {
+	u32 status;
+	u32 handle;
+};
+
+/*
+ * An operation whose request (size bytes at arg) holds no buffers: the
+ * handle it acts on (if acts_on) must be the file's; the handle it makes
+ * (at out, if not 0) becomes the file's; a handle it closes (closes) stops
+ * being the file's.
+ */
+static long plain(struct bridge_file *f, u32 op, void __user *arg, size_t size, bool acts_on, size_t out,
+		  bool closes)
+{
+	struct head *req;
+	long ret;
+
+	req = kmalloc(size, GFP_KERNEL);
+	if (!req)
+		return -ENOMEM;
+	ret = -EFAULT;
+	if (copy_from_user(req, arg, size))
+		goto out;
+	if (acts_on && !holds(f, req->handle)) {
+		req->status = VEDA_BAD_HANDLE;
+	} else {
+		ret = bridge_call(op, req);
+		if (ret)
+			goto out;
+		if (req->status == 0 && out)
+			keep(f, *(u32 *)((void *)req + out));
+		if (req->status == 0 && closes)
+			forget(f, req->handle);
+	}
+	ret = copy_to_user(arg, req, size) ? -EFAULT : 0;
+out:
+	kfree(req);
+	return ret;
+}
+
+static long do_channel_create(struct bridge_file *f, void __user *arg)
+{
+	struct veda_channel_create *c;
+	long ret;
+
+	c = kzalloc(sizeof(*c), GFP_KERNEL);
+	if (!c)
+		return -ENOMEM;
+	ret = bridge_call(8, c);
+	if (!ret && c->status == 0) {
+		keep(f, c->out[0]);
+		keep(f, c->out[1]);
+	}
+	if (!ret && copy_to_user(arg, c, sizeof(*c)))
+		ret = -EFAULT;
+	kfree(c);
+	return ret;
+}
+
+static long do_channel_write(struct bridge_file *f, void __user *arg)
+{
+	struct veda_channel_write *w;
+	u64 ubytes, uhandles;
+	void *bytes = NULL;
+	u32 *handles = NULL;
+	long ret;
+	u32 i;
+
+	w = kmalloc(sizeof(*w), GFP_KERNEL);
+	if (!w)
+		return -ENOMEM;
+	ret = -EFAULT;
+	if (copy_from_user(w, arg, sizeof(*w)))
+		goto out;
+	ret = -EINVAL;
+	if (w->bytes_len > MAX_BYTES || w->handles_len > MAX_HANDLES)
+		goto out;
+	ubytes = w->bytes;
+	uhandles = w->handles;
+	ret = -ENOMEM;
+	bytes = kmalloc(max(w->bytes_len, 1u), GFP_KERNEL);
+	handles = kmalloc_array(max(w->handles_len, 1u), sizeof(u32), GFP_KERNEL);
+	if (!bytes || !handles)
+		goto out;
+	ret = -EFAULT;
+	if (copy_from_user(bytes, u64_to_user_ptr(ubytes), w->bytes_len) ||
+	    copy_from_user(handles, u64_to_user_ptr(uhandles), w->handles_len * sizeof(u32)))
+		goto out;
+	w->consumed = 0;
+	w->status = VEDA_BAD_HANDLE;
+	if (!holds(f, w->handle))
+		goto reply;
+	for (i = 0; i < w->handles_len; i++)
+		if (!holds(f, handles[i]))
+			goto reply;
+	w->bytes = __pa(bytes);
+	w->handles = __pa(handles);
+	ret = bridge_call(9, w);
+	if (ret)
+		goto out;
+	if (w->consumed)
+		for (i = 0; i < w->handles_len; i++)
+			forget(f, handles[i]);
+	w->bytes = ubytes;
+	w->handles = uhandles;
+reply:
+	ret = copy_to_user(arg, w, sizeof(*w)) ? -EFAULT : 0;
+out:
+	kfree(handles);
+	kfree(bytes);
+	kfree(w);
+	return ret;
+}
+
+static long do_channel_read(struct bridge_file *f, void __user *arg)
+{
+	struct veda_channel_read *r;
+	u64 ubytes, uhandles;
+	void *bytes = NULL;
+	u32 *handles = NULL;
+	long ret;
+	u32 i;
+
+	r = kmalloc(sizeof(*r), GFP_KERNEL);
+	if (!r)
+		return -ENOMEM;
+	ret = -EFAULT;
+	if (copy_from_user(r, arg, sizeof(*r)))
+		goto out;
+	r->bytes_capacity = min_t(u32, r->bytes_capacity, MAX_BYTES);
+	r->handles_capacity = min_t(u32, r->handles_capacity, MAX_HANDLES);
+	ubytes = r->bytes;
+	uhandles = r->handles;
+	if (!holds(f, r->handle)) {
+		r->status = VEDA_BAD_HANDLE;
+		goto reply;
+	}
+	ret = -ENOMEM;
+	bytes = kmalloc(max(r->bytes_capacity, 1u), GFP_KERNEL);
+	handles = kmalloc_array(max(r->handles_capacity, 1u), sizeof(u32), GFP_KERNEL);
+	if (!bytes || !handles)
+		goto out;
+	r->bytes = __pa(bytes);
+	r->handles = __pa(handles);
+	ret = bridge_call(10, r);
+	if (ret)
+		goto out;
+	if (r->status == 0) {
+		for (i = 0; i < r->handles_len; i++)
+			keep(f, handles[i]);
+		ret = -EFAULT;
+		if (copy_to_user(u64_to_user_ptr(ubytes), bytes, r->bytes_len) ||
+		    copy_to_user(u64_to_user_ptr(uhandles), handles, r->handles_len * sizeof(u32)))
+			goto out;
+	}
+	r->bytes = ubytes;
+	r->handles = uhandles;
+reply:
+	ret = copy_to_user(arg, r, sizeof(*r)) ? -EFAULT : 0;
+out:
+	kfree(handles);
+	kfree(bytes);
+	kfree(r);
+	return ret;
+}
+
+static long do_vmo_copy(struct bridge_file *f, u32 op, void __user *arg)
+{
+	struct veda_vmo_copy *c;
+	void *buffer = NULL;
+	u64 ubuffer;
+	long ret;
+
+	c = kmalloc(sizeof(*c), GFP_KERNEL);
+	if (!c)
+		return -ENOMEM;
+	ret = -EFAULT;
+	if (copy_from_user(c, arg, sizeof(*c)))
+		goto out;
+	ret = -EINVAL;
+	if (c->len > MAX_COPY)
+		goto out;
+	ubuffer = c->buffer;
+	if (!holds(f, c->handle)) {
+		c->status = VEDA_BAD_HANDLE;
+		goto reply;
+	}
+	ret = -ENOMEM;
+	buffer = kmalloc(max_t(u64, c->len, 1), GFP_KERNEL);
+	if (!buffer)
+		goto out;
+	ret = -EFAULT;
+	if (op == 15 && copy_from_user(buffer, u64_to_user_ptr(ubuffer), c->len))
+		goto out;
+	c->buffer = __pa(buffer);
+	ret = bridge_call(op, c);
+	if (ret)
+		goto out;
+	ret = -EFAULT;
+	if (op == 14 && c->status == 0 && copy_to_user(u64_to_user_ptr(ubuffer), buffer, c->len))
+		goto out;
+	c->buffer = ubuffer;
+reply:
+	ret = copy_to_user(arg, c, sizeof(*c)) ? -EFAULT : 0;
+out:
+	kfree(buffer);
+	kfree(c);
+	return ret;
+}
+
+/* Veda's log, read into a copy of the driver's, then the program's. */
+static long do_log_read(void __user *arg)
+{
+	struct veda_log_read *r;
+	void *buffer = NULL;
+	u64 ubuffer;
+	long ret;
+
+	r = kmalloc(sizeof(*r), GFP_KERNEL);
+	if (!r)
+		return -ENOMEM;
+	ret = -EFAULT;
+	if (copy_from_user(r, arg, sizeof(*r)))
+		goto out;
+	ret = -EINVAL;
+	if (r->len > MAX_COPY)
+		goto out;
+	ret = -ENOMEM;
+	buffer = kmalloc(max_t(u64, r->len, 1), GFP_KERNEL);
+	if (!buffer)
+		goto out;
+	ubuffer = r->buffer;
+	r->buffer = __pa(buffer);
+	ret = bridge_call(22, r);
+	if (ret)
+		goto out;
+	ret = -EFAULT;
+	if (r->status == 0 && copy_to_user(u64_to_user_ptr(ubuffer), buffer, r->len))
+		goto out;
+	r->buffer = ubuffer;
+	ret = copy_to_user(arg, r, sizeof(*r)) ? -EFAULT : 0;
+out:
+	kfree(buffer);
+	kfree(r);
+	return ret;
+}
+
+static long do_wait(struct bridge_file *f, void __user *arg)
+{
+	struct veda_wait *w;
+	struct veda_wait_item *items = NULL;
+	struct waiter waiter = {};
+	unsigned long flags;
+	u64 uitems;
+	size_t size;
+	long ret;
+	u32 i;
+
+	w = kmalloc(sizeof(*w), GFP_KERNEL);
+	if (!w)
+		return -ENOMEM;
+	ret = -EFAULT;
+	if (copy_from_user(w, arg, sizeof(*w)))
+		goto out;
+	ret = -EINVAL;
+	if (!w->count || w->count > MAX_WAIT_ITEMS)
+		goto out;
+	uitems = w->items;
+	size = w->count * sizeof(*items);
+	ret = -ENOMEM;
+	items = kmalloc(size, GFP_KERNEL);
+	if (!items)
+		goto out;
+	ret = -EFAULT;
+	if (copy_from_user(items, u64_to_user_ptr(uitems), size))
+		goto out;
+	for (i = 0; i < w->count; i++) {
+		if (!holds(f, items[i].handle)) {
+			w->status = VEDA_BAD_HANDLE;
+			goto reply;
+		}
+	}
+	w->items = __pa(items);
+	w->key = atomic64_inc_return(&next_key);
+	waiter.key = w->key;
+	/* Listed before the monitor may finish it. */
+	spin_lock_irqsave(&waiters_lock, flags);
+	list_add(&waiter.node, &waiters);
+	spin_unlock_irqrestore(&waiters_lock, flags);
+	ret = bridge_call(OP_WAIT, w);
+	if (!ret && w->status == VEDA_PENDING) {
+		if (wait_event_interruptible(waiters_queue, READ_ONCE(waiter.done))) {
+			struct cancel *c = kzalloc(sizeof(*c), GFP_KERNEL);
+
+			/* Given up, unless the monitor finished it meanwhile:
+			 * its completion is then on its way. */
+			if (c) {
+				c->key = waiter.key;
+				ret = bridge_call(OP_CANCEL, c);
+				if (!ret && c->status == 0)
+					ret = -EINTR;
+				else
+					wait_event(waiters_queue, READ_ONCE(waiter.done));
+				kfree(c);
+			} else {
+				wait_event(waiters_queue, READ_ONCE(waiter.done));
+			}
+		}
+		w->status = waiter.status;
+		w->satisfied = waiter.satisfied;
+	}
+	spin_lock_irqsave(&waiters_lock, flags);
+	list_del(&waiter.node);
+	spin_unlock_irqrestore(&waiters_lock, flags);
+	if (ret)
+		goto out;
+	/* What was observed, into the program's items. */
+	ret = -EFAULT;
+	if (copy_to_user(u64_to_user_ptr(uitems), items, size))
+		goto out;
+	w->items = uitems;
+reply:
+	ret = copy_to_user(arg, w, sizeof(*w)) ? -EFAULT : 0;
+out:
+	kfree(items);
+	kfree(w);
+	return ret;
+}
+
+/* A watch: kernel memory, which the monitor reads and writes. */
+struct watch {
+	/* The /dev/veda file whose handle it watches. */
+	struct file *bridge;
+	u32 handle;
+	u32 signals;
+	struct mutex lock;
+	/* A wait is with the monitor; it finished (and is not read yet). */
+	bool armed;
+	bool ready;
+	struct waiter waiter;
+	struct veda_wait wait;
+	struct veda_wait_item item;
+	struct cancel cancel;
+};
+
+static void unlist(struct waiter *waiter)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&waiters_lock, flags);
+	list_del(&waiter->node);
+	spin_unlock_irqrestore(&waiters_lock, flags);
+}
+
+/* Takes the finished wait, if it did. */
+static void watch_update(struct watch *w)
+{
+	if (w->armed && READ_ONCE(w->waiter.done)) {
+		unlist(&w->waiter);
+		w->wait.status = w->waiter.status;
+		w->armed = false;
+		w->ready = true;
+	}
+}
+
+/* Waits for the signals again: ready at once if they are active. */
+static void watch_arm(struct watch *w)
+{
+	struct bridge_file *f = w->bridge->private_data;
+	unsigned long flags;
+
+	w->ready = true;
+	if (!holds(f, w->handle)) {
+		w->wait.status = VEDA_BAD_HANDLE;
+		return;
+	}
+	w->item = (struct veda_wait_item){ .handle = w->handle, .signals = w->signals };
+	w->wait = (struct veda_wait){ .count = 1, .items = __pa(&w->item), .deadline = ~0ULL };
+	w->wait.key = atomic64_inc_return(&next_key);
+	w->waiter.key = w->wait.key;
+	w->waiter.done = false;
+	/* Listed before the monitor may finish it. */
+	spin_lock_irqsave(&waiters_lock, flags);
+	list_add(&w->waiter.node, &waiters);
+	spin_unlock_irqrestore(&waiters_lock, flags);
+	if (bridge_call(OP_WAIT, &w->wait)) {
+		unlist(&w->waiter);
+		w->wait.status = VEDA_BAD_HANDLE;
+	} else if (w->wait.status == VEDA_PENDING) {
+		w->armed = true;
+		w->ready = false;
+	} else {
+		unlist(&w->waiter);
+	}
+}
+
+static __poll_t watch_poll(struct file *file, poll_table *pt)
+{
+	struct watch *w = file->private_data;
+	__poll_t mask = 0;
+
+	poll_wait(file, &waiters_queue, pt);
+	mutex_lock(&w->lock);
+	watch_update(w);
+	if (!w->ready && !w->armed)
+		watch_arm(w);
+	if (w->ready)
+		mask = w->wait.status ? EPOLLERR : EPOLLIN | EPOLLRDNORM;
+	mutex_unlock(&w->lock);
+	return mask;
+}
+
+static ssize_t watch_read(struct file *file, char __user *buf, size_t len, loff_t *pos)
+{
+	struct watch *w = file->private_data;
+	u32 observed;
+
+	if (len < sizeof(observed))
+		return -EINVAL;
+	mutex_lock(&w->lock);
+	for (;;) {
+		watch_update(w);
+		if (!w->ready && !w->armed)
+			watch_arm(w);
+		if (w->ready)
+			break;
+		mutex_unlock(&w->lock);
+		if (file->f_flags & O_NONBLOCK)
+			return -EAGAIN;
+		if (wait_event_interruptible(waiters_queue, READ_ONCE(w->waiter.done)))
+			return -ERESTARTSYS;
+		mutex_lock(&w->lock);
+	}
+	if (w->wait.status) {
+		mutex_unlock(&w->lock);
+		return -EIO;
+	}
+	observed = w->item.observed;
+	w->ready = false;
+	mutex_unlock(&w->lock);
+	return copy_to_user(buf, &observed, sizeof(observed)) ? -EFAULT : sizeof(observed);
+}
+
+static int watch_release(struct inode *inode, struct file *file)
+{
+	struct watch *w = file->private_data;
+
+	if (w->armed) {
+		/* Given up, unless the monitor finished it meanwhile: its
+		 * completion is then on its way, and writes w->item. */
+		w->cancel.key = w->waiter.key;
+		if (bridge_call(OP_CANCEL, &w->cancel) || w->cancel.status)
+			wait_event(waiters_queue, READ_ONCE(w->waiter.done));
+		unlist(&w->waiter);
+	}
+	fput(w->bridge);
+	kfree(w);
+	return 0;
+}
+
+static const struct file_operations watch_fops = {
+	.owner = THIS_MODULE,
+	.poll = watch_poll,
+	.read = watch_read,
+	.release = watch_release,
+	.llseek = noop_llseek,
+};
+
+static long do_watch(struct file *file, void __user *arg)
+{
+	struct bridge_file *f = file->private_data;
+	struct veda_watch req;
+	struct file *wf;
+	struct watch *w;
+	int fd;
+
+	if (copy_from_user(&req, arg, sizeof(req)))
+		return -EFAULT;
+	if (!holds(f, req.handle)) {
+		req.status = VEDA_BAD_HANDLE;
+		return copy_to_user(arg, &req, sizeof(req)) ? -EFAULT : 0;
+	}
+	w = kzalloc(sizeof(*w), GFP_KERNEL);
+	if (!w)
+		return -ENOMEM;
+	mutex_init(&w->lock);
+	w->handle = req.handle;
+	w->signals = req.signals;
+	fd = get_unused_fd_flags(O_CLOEXEC);
+	if (fd < 0) {
+		kfree(w);
+		return fd;
+	}
+	wf = anon_inode_getfile("[veda-watch]", &watch_fops, w, O_RDONLY);
+	if (IS_ERR(wf)) {
+		put_unused_fd(fd);
+		kfree(w);
+		return PTR_ERR(wf);
+	}
+	w->bridge = get_file(file);
+	req.status = 0;
+	req.fd = fd;
+	if (copy_to_user(arg, &req, sizeof(req))) {
+		put_unused_fd(fd);
+		fput(wf);
+		return -EFAULT;
+	}
+	fd_install(fd, wf);
+	return 0;
+}
+
+static long do_vmo_map(struct bridge_file *f, void __user *arg)
+{
+	struct veda_vmo_map *m;
+	struct mapping *mapping;
+	long ret;
+
+	m = kmalloc(sizeof(*m), GFP_KERNEL);
+	mapping = kzalloc(sizeof(*mapping), GFP_KERNEL);
+	ret = -ENOMEM;
+	if (!m || !mapping)
+		goto out;
+	ret = -EFAULT;
+	if (copy_from_user(m, arg, sizeof(*m)))
+		goto out;
+	if (!holds(f, m->handle)) {
+		m->status = VEDA_BAD_HANDLE;
+	} else {
+		ret = bridge_call(OP_VMO_MAP, m);
+		if (ret)
+			goto out;
+		if (m->status == 0) {
+			mapping->file = f;
+			mapping->gpa = m->gpa;
+			mapping->len = m->len;
+			mapping->flags = m->flags;
+			mutex_lock(&f->mappings_lock);
+			list_add(&mapping->node, &f->mappings);
+			mutex_unlock(&f->mappings_lock);
+			mapping = NULL;
+		}
+	}
+	ret = copy_to_user(arg, m, sizeof(*m)) ? -EFAULT : 0;
+out:
+	kfree(mapping);
+	kfree(m);
+	return ret;
+}
+
+/* The monitor unmaps a VMO's pages from the guest. */
+static void unmap_range(u64 gpa, u64 len)
+{
+	struct veda_vmo_map *m = kzalloc(sizeof(*m), GFP_KERNEL);
+
+	if (m) {
+		m->gpa = gpa;
+		m->len = len;
+		bridge_call(OP_VMO_UNMAP, m);
+		kfree(m);
+	}
+}
+
+/* (mappings_lock held) */
+static void unmap(struct mapping *mapping)
+{
+	unmap_range(mapping->gpa, mapping->len);
+	list_del(&mapping->node);
+	kfree(mapping);
+}
+
+/* A VMO's dma-buf: the range the monitor mapped it at. */
+struct vmo_buf {
+	u64 gpa;
+	u64 len;
+	bool writable;
+};
+
+/* The range as DMA addresses for the importer's device, in segments it
+ * takes; no pages (the range is not the guest's RAM). */
+static struct sg_table *vmo_buf_map(struct dma_buf_attachment *attach, enum dma_data_direction dir)
+{
+	struct vmo_buf *b = attach->dmabuf->priv;
+	u64 seg = dma_get_max_seg_size(attach->dev) & PAGE_MASK;
+	struct scatterlist *sg;
+	struct sg_table *sgt;
+	unsigned int i, n;
+	u64 at = 0;
+
+	if (dir != DMA_TO_DEVICE && !b->writable)
+		return ERR_PTR(-EACCES);
+	if (!seg)
+		seg = PAGE_SIZE;
+	n = DIV_ROUND_UP(b->len, seg);
+	sgt = kzalloc(sizeof(*sgt), GFP_KERNEL);
+	if (!sgt || sg_alloc_table(sgt, n, GFP_KERNEL)) {
+		kfree(sgt);
+		return ERR_PTR(-ENOMEM);
+	}
+	for_each_sgtable_sg(sgt, sg, i) {
+		u64 len = min(seg, b->len - at);
+		dma_addr_t addr = dma_map_resource(attach->dev, b->gpa + at, len, dir, DMA_ATTR_SKIP_CPU_SYNC);
+
+		if (dma_mapping_error(attach->dev, addr)) {
+			sgt->nents = i;
+			goto fail;
+		}
+		sg->length = len;
+		sg_dma_address(sg) = addr;
+		sg_dma_len(sg) = len;
+		at += len;
+	}
+	sgt->nents = n;
+	return sgt;
+fail:
+	for_each_sgtable_dma_sg(sgt, sg, i)
+		dma_unmap_resource(attach->dev, sg_dma_address(sg), sg_dma_len(sg), dir, DMA_ATTR_SKIP_CPU_SYNC);
+	sg_free_table(sgt);
+	kfree(sgt);
+	return ERR_PTR(-ENOMEM);
+}
+
+static void vmo_buf_unmap(struct dma_buf_attachment *attach, struct sg_table *sgt, enum dma_data_direction dir)
+{
+	struct scatterlist *sg;
+	unsigned int i;
+
+	for_each_sgtable_dma_sg(sgt, sg, i)
+		dma_unmap_resource(attach->dev, sg_dma_address(sg), sg_dma_len(sg), dir, DMA_ATTR_SKIP_CPU_SYNC);
+	sg_free_table(sgt);
+	kfree(sgt);
+}
+
+/* For importers that copy with the processor (a display without DMA of
+ * its own): the range, cached. */
+static int vmo_buf_vmap(struct dma_buf *dmabuf, struct iosys_map *map)
+{
+	struct vmo_buf *b = dmabuf->priv;
+	void *vaddr = memremap(b->gpa, b->len, MEMREMAP_WB);
+
+	if (!vaddr)
+		return -ENOMEM;
+	iosys_map_set_vaddr(map, vaddr);
+	return 0;
+}
+
+static void vmo_buf_vunmap(struct dma_buf *dmabuf, struct iosys_map *map)
+{
+	memunmap(map->vaddr);
+}
+
+static void vmo_buf_release(struct dma_buf *dmabuf)
+{
+	struct vmo_buf *b = dmabuf->priv;
+
+	unmap_range(b->gpa, b->len);
+	kfree(b);
+}
+
+static const struct dma_buf_ops vmo_buf_ops = {
+	.map_dma_buf = vmo_buf_map,
+	.unmap_dma_buf = vmo_buf_unmap,
+	.vmap = vmo_buf_vmap,
+	.vunmap = vmo_buf_vunmap,
+	.release = vmo_buf_release,
+};
+
+static long do_vmo_dmabuf(struct bridge_file *f, void __user *arg)
+{
+	DEFINE_DMA_BUF_EXPORT_INFO(info);
+	struct veda_vmo_dmabuf req;
+	struct veda_vmo_map *m;
+	struct dma_buf *buf;
+	struct vmo_buf *b;
+	long ret;
+	int fd;
+
+	if (copy_from_user(&req, arg, sizeof(req)))
+		return -EFAULT;
+	if (!holds(f, req.handle)) {
+		req.status = VEDA_BAD_HANDLE;
+		return copy_to_user(arg, &req, sizeof(req)) ? -EFAULT : 0;
+	}
+	m = kzalloc(sizeof(*m), GFP_KERNEL);
+	b = kzalloc(sizeof(*b), GFP_KERNEL);
+	ret = -ENOMEM;
+	if (!m || !b)
+		goto out;
+	m->handle = req.handle;
+	m->offset = req.offset;
+	m->len = req.len;
+	m->flags = req.flags;
+	ret = bridge_call(OP_VMO_MAP, m);
+	if (ret)
+		goto out;
+	req.status = m->status;
+	if (m->status) {
+		ret = copy_to_user(arg, &req, sizeof(req)) ? -EFAULT : 0;
+		goto out;
+	}
+	b->gpa = m->gpa;
+	b->len = m->len;
+	b->writable = m->flags & 2;
+	info.ops = &vmo_buf_ops;
+	info.size = b->len;
+	info.flags = O_RDWR | O_CLOEXEC;
+	info.priv = b;
+	buf = dma_buf_export(&info);
+	if (IS_ERR(buf)) {
+		unmap_range(b->gpa, b->len);
+		ret = PTR_ERR(buf);
+		goto out;
+	}
+	/* The dma-buf has the range now. */
+	b = NULL;
+	fd = get_unused_fd_flags(O_CLOEXEC);
+	if (fd < 0) {
+		dma_buf_put(buf);
+		ret = fd;
+		goto out;
+	}
+	req.fd = fd;
+	if (copy_to_user(arg, &req, sizeof(req))) {
+		put_unused_fd(fd);
+		dma_buf_put(buf);
+		ret = -EFAULT;
+		goto out;
+	}
+	fd_install(fd, buf->file);
+	ret = 0;
+out:
+	kfree(b);
+	kfree(m);
+	return ret;
+}
+
+static long bridge_ioctl(struct file *file, unsigned int cmd, unsigned long arg)
+{
+	struct bridge_file *f = file->private_data;
+	void __user *uarg = (void __user *)arg;
+
+	switch (cmd) {
+	case VEDA_IOC_CLOSE:
+		return plain(f, 2, uarg, sizeof(struct veda_close), true, 0, true);
+	case VEDA_IOC_DUPLICATE:
+		return plain(f, 3, uarg, sizeof(struct veda_duplicate), true, offsetof(struct veda_duplicate, out),
+			     false);
+	case VEDA_IOC_OBJECT_INFO:
+		return plain(f, 4, uarg, sizeof(struct veda_object_info), true, 0, false);
+	case VEDA_IOC_SIGNAL:
+		return plain(f, 5, uarg, sizeof(struct veda_signal), true, 0, false);
+	case VEDA_IOC_WAIT:
+		return do_wait(f, uarg);
+	case VEDA_IOC_CHANNEL_CREATE:
+		return do_channel_create(f, uarg);
+	case VEDA_IOC_CHANNEL_WRITE:
+		return do_channel_write(f, uarg);
+	case VEDA_IOC_CHANNEL_READ:
+		return do_channel_read(f, uarg);
+	case VEDA_IOC_EVENT_CREATE:
+		return plain(f, 11, uarg, sizeof(struct veda_event_create), false,
+			     offsetof(struct veda_event_create, out), false);
+	case VEDA_IOC_VMO_CREATE:
+		return plain(f, 12, uarg, sizeof(struct veda_vmo), false, offsetof(struct veda_vmo, handle), false);
+	case VEDA_IOC_VMO_SIZE:
+		return plain(f, 13, uarg, sizeof(struct veda_vmo), true, 0, false);
+	case VEDA_IOC_VMO_READ:
+		return do_vmo_copy(f, 14, uarg);
+	case VEDA_IOC_VMO_WRITE:
+		return do_vmo_copy(f, 15, uarg);
+	case VEDA_IOC_VMO_MAP:
+		return do_vmo_map(f, uarg);
+	case VEDA_IOC_BOOTSTRAP:
+		return plain(f, 18, uarg, sizeof(struct veda_bootstrap), false, offsetof(struct veda_bootstrap, out),
+			     false);
+	case VEDA_IOC_CLOCK:
+		return plain(f, 19, uarg, sizeof(struct veda_clock), false, 0, false);
+	case VEDA_IOC_VMO_DMABUF:
+		return do_vmo_dmabuf(f, uarg);
+	case VEDA_IOC_WATCH:
+		return do_watch(file, uarg);
+	case VEDA_IOC_LOG_READ:
+		return do_log_read(uarg);
+	default:
+		return -ENOTTY;
+	}
+}
+
+static void mapping_close(struct vm_area_struct *vma)
+{
+	struct mapping *mapping = vma->vm_private_data;
+	struct bridge_file *f = mapping->file;
+
+	mutex_lock(&f->mappings_lock);
+	unmap(mapping);
+	mutex_unlock(&f->mappings_lock);
+}
+
+/* A mapping is one piece: it goes whole. */
+static int mapping_may_split(struct vm_area_struct *vma, unsigned long addr)
+{
+	return -EINVAL;
+}
+
+static const struct vm_operations_struct mapping_ops = {
+	.close = mapping_close,
+	.may_split = mapping_may_split,
+};
+
+static int bridge_mmap(struct file *file, struct vm_area_struct *vma)
+{
+	struct bridge_file *f = file->private_data;
+	u64 gpa = (u64)vma->vm_pgoff << PAGE_SHIFT;
+	u64 len = vma->vm_end - vma->vm_start;
+	struct mapping *mapping, *found = NULL;
+	int ret = -EINVAL;
+
+	mutex_lock(&f->mappings_lock);
+	list_for_each_entry(mapping, &f->mappings, node) {
+		if (mapping->gpa == gpa && mapping->len == len && !mapping->mapped) {
+			found = mapping;
+			break;
+		}
+	}
+	if (!found)
+		goto out;
+	ret = -EACCES;
+	if ((vma->vm_flags & VM_WRITE) && !(found->flags & 2))
+		goto out;
+	if (!(found->flags & 2))
+		vm_flags_clear(vma, VM_MAYWRITE);
+	vm_flags_set(vma, VM_IO | VM_PFNMAP | VM_DONTEXPAND | VM_DONTDUMP | VM_DONTCOPY);
+	vma->vm_ops = &mapping_ops;
+	vma->vm_private_data = found;
+	ret = remap_pfn_range(vma, vma->vm_start, gpa >> PAGE_SHIFT, len, vma->vm_page_prot);
+	if (!ret)
+		found->mapped = true;
+out:
+	mutex_unlock(&f->mappings_lock);
+	return ret;
+}
+
+static int bridge_open(struct inode *inode, struct file *file)
+{
+	struct bridge_file *f = kzalloc(sizeof(*f), GFP_KERNEL);
+
+	if (!f)
+		return -ENOMEM;
+	xa_init(&f->handles);
+	mutex_init(&f->mappings_lock);
+	INIT_LIST_HEAD(&f->mappings);
+	file->private_data = f;
+	return 0;
+}
+
+static int bridge_release(struct inode *inode, struct file *file)
+{
+	struct bridge_file *f = file->private_data;
+	struct mapping *mapping, *next;
+	struct veda_close *c;
+	unsigned long handle;
+	void *entry;
+
+	c = kzalloc(sizeof(*c), GFP_KERNEL);
+	xa_for_each(&f->handles, handle, entry) {
+		if (c) {
+			c->handle = handle;
+			bridge_call(2, c);
+		}
+	}
+	kfree(c);
+	xa_destroy(&f->handles);
+	/* Mappings no program mapped (those mapped went with their VMAs). */
+	mutex_lock(&f->mappings_lock);
+	list_for_each_entry_safe(mapping, next, &f->mappings, node)
+		unmap(mapping);
+	mutex_unlock(&f->mappings_lock);
+	kfree(f);
+	return 0;
+}
+
+static const struct file_operations bridge_fops = {
+	.owner = THIS_MODULE,
+	.open = bridge_open,
+	.release = bridge_release,
+	.unlocked_ioctl = bridge_ioctl,
+	.mmap = bridge_mmap,
+};
+
+static struct miscdevice bridge_device = {
+	.minor = MISC_DYNAMIC_MINOR,
+	.name = "veda",
+	.fops = &bridge_fops,
+	.mode = 0600,
+};
+
+static int __init bridge_init(void)
+{
+	struct setup *s;
+	int ret;
+
+	if (!veda_platform())
+		return -ENODEV;
+	ring = (void *)get_zeroed_page(GFP_KERNEL);
+	s = kzalloc(sizeof(*s), GFP_KERNEL);
+	ret = -ENOMEM;
+	if (!ring || !s)
+		goto fail;
+	veda_set_callback(bridge_callback);
+	s->vector = VEDA_CALLBACK_VECTOR;
+	s->ring = __pa(ring);
+	ret = bridge_call(OP_SETUP, s);
+	if (!ret && s->status)
+		ret = -ENODEV;
+	if (ret)
+		goto fail;
+	kfree(s);
+	return misc_register(&bridge_device);
+fail:
+	veda_set_callback(NULL);
+	kfree(s);
+	free_page((unsigned long)ring);
+	return ret;
+}
+device_initcall(bridge_init);
