+++ b/drivers/tty/hvc/hvc_veda.c
@@ -0,0 +1,76 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * The console of Linux in Veda's driver VM: bytes go to Veda's log through
+ * the platform's console hypercall, up to 32 at a time in registers (so it
+ * works however early, and whatever state the kernel is in). The console
+ * takes no input.
+ */
+
+#include <linux/console.h>
+#include <linux/init.h>
+#include <linux/serial_core.h>
+#include <linux/string.h>
+#include <asm/veda_para.h>
+
+#include "hvc_console.h"
+
+static void veda_console_write(const u8 *buf, size_t count)
+{
+	unsigned long r[4];
+
+	while (count) {
+		size_t n = min_t(size_t, count, sizeof(r));
+
+		memset(r, 0, sizeof(r));
+		memcpy(r, buf, n);
+		veda_hypercall(VEDA_HC_CONSOLE_WRITE, n, r[0], r[1], r[2], r[3]);
+		buf += n;
+		count -= n;
+	}
+}
+
+static void veda_early_write(struct console *con, const char *s, unsigned int n)
+{
+	veda_console_write(s, n);
+}
+
+static int __init veda_early_setup(struct earlycon_device *device, const char *opt)
+{
+	if (!veda_platform())
+		return -ENODEV;
+	device->con->write = veda_early_write;
+	return 0;
+}
+EARLYCON_DECLARE(veda, veda_early_setup);
+
+static ssize_t veda_put_chars(uint32_t vt, const u8 *buf, size_t count)
+{
+	veda_console_write(buf, count);
+	return count;
+}
+
+static ssize_t veda_get_chars(uint32_t vt, u8 *buf, size_t count)
+{
+	return 0;
+}
+
+static const struct hv_ops veda_hvc_ops = {
+	.get_chars = veda_get_chars,
+	.put_chars = veda_put_chars,
+};
+
+static int __init veda_console_init(void)
+{
+	if (!veda_platform())
+		return -ENODEV;
+	return hvc_instantiate(0, 0, &veda_hvc_ops) < 0 ? -ENODEV : 0;
+}
+console_initcall(veda_console_init);
+
+static int __init veda_hvc_init(void)
+{
+	if (!veda_platform())
+		return -ENODEV;
+	return PTR_ERR_OR_ZERO(hvc_alloc(0, 0, &veda_hvc_ops, 128));
+}
+device_initcall(veda_hvc_init);
--- /dev/null
+++ b/include/uapi/linux/veda.h
@@ -0,0 +1,220 @@
+/* SPDX-License-Identifier: GPL-2.0 WITH Linux-syscall-note */
+/*
+ * The bridge of Veda's driver VM: Veda's IPC for the programs of Linux in
+ * it, through /dev/veda.
+ *
+ * Each ioctl stands for the Veda system call of its name, on Veda objects
+ * the guest holds through handles of its own (32-bit numbers). Its
+ * request starts with the status of the operation: 0, or a Veda error
+ * code; the ioctl itself fails only when the request cannot be carried to
+ * Veda (EFAULT, ENOMEM, EINTR...). Buffers are the program's.
+ *
+ * A VMO is mapped with VEDA_IOC_VMO_MAP, which gives the offset to mmap
+ * /dev/veda at (MAP_SHARED, the length asked for); it is unmapped with
+ * munmap.
+ *
+ * These are the definitions of Veda's own
+ * implementation/libraries/hv/src/bridge.rs.
+ */
+#ifndef _UAPI_LINUX_VEDA_H
+#define _UAPI_LINUX_VEDA_H
+
+#include <linux/ioctl.h>
+#include <linux/types.h>
+
+struct veda_close {
+	__u32 status;
+	__u32 handle;
+};
+
+/* rights 0: the handle's own. */
+struct veda_duplicate {
+	__u32 status;
+	__u32 handle;
+	__u32 rights;
+	__u32 out;
+};
+
+struct veda_object_info {
+	__u32 status;
+	__u32 handle;
+	__u64 koid;
+	__u32 object_type;
+	__u32 rights;
+};
+
+struct veda_signal {
+	__u32 status;
+	__u32 handle;
+	__u32 clear;
+	__u32 set;
+};
+
+struct veda_wait_item {
+	__u32 handle;
+	__u32 signals;
+	__u32 observed;
+	__u32 reserved;
+};
+
+/* Until a signal of an item is active, or the deadline (Veda's monotonic
+ * time, ns; ~0 for none) passes. */
+struct veda_wait {
+	__u32 status;
+	__u32 count;
+	__u64 items;
+	__u64 deadline;
+	__u64 key;
+	__u32 satisfied;
+	__u32 reserved;
+};
+
+struct veda_channel_create {
+	__u32 status;
+	__u32 reserved;
+	__u32 out[2];
+};
+
+/* The handles go with the message (consumed: they are gone, even if the
+ * write failed). */
+struct veda_channel_write {
+	__u32 status;
+	__u32 handle;
+	__u64 bytes;
+	__u64 handles;
+	__u32 bytes_len;
+	__u32 handles_len;
+	__u32 consumed;
+	__u32 reserved;
+};
+
+/* The lengths say what the message held, also when the buffers were too
+ * small (it then stays queued). */
+struct veda_channel_read {
+	__u32 status;
+	__u32 handle;
+	__u64 bytes;
+	__u64 handles;
+	__u32 bytes_capacity;
+	__u32 handles_capacity;
+	__u32 bytes_len;
+	__u32 handles_len;
+};
+
+struct veda_event_create {
+	__u32 status;
+	__u32 out;
+};
+
+/* VMO_CREATE (out: handle) and VMO_SIZE. */
+struct veda_vmo {
+	__u32 status;
+	__u32 handle;
+	__u64 size;
+	__u32 flags;
+	__u32 reserved;
+};
+
+struct veda_vmo_copy {
+	__u32 status;
+	__u32 handle;
+	__u64 offset;
+	__u64 buffer;
+	__u64 len;
+};
+
+/* flags: 1 read, 2 write. gpa: where to mmap /dev/veda. */
+struct veda_vmo_map {
+	__u32 status;
+	__u32 handle;
+	__u64 offset;
+	__u64 len;
+	__u64 gpa;
+	__u32 flags;
+	__u32 reserved;
+};
+
+struct veda_bootstrap {
+	__u32 status;
+	__u32 role;
+	__u32 out;
+	__u32 reserved;
+};
+
+/* Veda's clocks: monotonic ns = ((tsc - tsc_at_zero) * ns_per_tick) >> 32. */
+struct veda_clock {
+	__u32 status;
+	__u32 reserved;
+	__u64 tsc_at_zero;
+	__u64 ns_per_tick;
+	__u64 tsc_hz;
+	__u64 realtime_at_zero;
+	__u64 utc_at_zero;
+};
+
+/*
+ * A file (fd, out) that is readable while one of the handle's signals is
+ * active: so that a program polls Veda's objects with its other files.
+ * Reading it gives the signals active then (a __u32); the next poll waits
+ * for them again. A handle that is gone makes it an error (EPOLLERR, EIO).
+ */
+struct veda_watch {
+	__u32 status;
+	__u32 handle;
+	__u32 signals;
+	__s32 fd;
+};
+
+/*
+ * A dma-buf (fd, out) of len bytes of the VMO from offset, which the
+ * monitor maps as VEDA_IOC_VMO_MAP does (flags too): Linux's drivers reach
+ * Veda's memory through it, a display scanning a picture out, a GPU
+ * rendering into it. The pages stay mapped while the dma-buf lives.
+ */
+struct veda_vmo_dmabuf {
+	__u32 status;
+	__u32 handle;
+	__u64 offset;
+	__u64 len;
+	__u32 flags;
+	__s32 fd;
+};
+
+/*
+ * Up to len bytes of Veda's log (every program's lines, Linux's console
+ * among them) from offset (counted from the first byte ever logged) into
+ * buffer, at most 64 KiB. Out: len is what was read, next the
+ * offset after it. The log keeps its latest part only: what was read
+ * starts later than offset (at next - len) if that is gone.
+ */
+struct veda_log_read {
+	__u32 status;
+	__u32 reserved;
+	__u64 offset;
+	__u64 buffer;
+	__u64 len;
+	__u64 next;
+};
+
+#define VEDA_IOCTL		0xB9
+#define VEDA_IOC_CLOSE		_IOWR(VEDA_IOCTL, 2, struct veda_close)
+#define VEDA_IOC_DUPLICATE	_IOWR(VEDA_IOCTL, 3, struct veda_duplicate)
+#define VEDA_IOC_OBJECT_INFO	_IOWR(VEDA_IOCTL, 4, struct veda_object_info)
+#define VEDA_IOC_SIGNAL		_IOWR(VEDA_IOCTL, 5, struct veda_signal)
+#define VEDA_IOC_WAIT		_IOWR(VEDA_IOCTL, 6, struct veda_wait)
+#define VEDA_IOC_CHANNEL_CREATE	_IOWR(VEDA_IOCTL, 8, struct veda_channel_create)
+#define VEDA_IOC_CHANNEL_WRITE	_IOWR(VEDA_IOCTL, 9, struct veda_channel_write)
+#define VEDA_IOC_CHANNEL_READ	_IOWR(VEDA_IOCTL, 10, struct veda_channel_read)
+#define VEDA_IOC_EVENT_CREATE	_IOWR(VEDA_IOCTL, 11, struct veda_event_create)
+#define VEDA_IOC_VMO_CREATE	_IOWR(VEDA_IOCTL, 12, struct veda_vmo)
+#define VEDA_IOC_VMO_SIZE	_IOWR(VEDA_IOCTL, 13, struct veda_vmo)
+#define VEDA_IOC_VMO_READ	_IOWR(VEDA_IOCTL, 14, struct veda_vmo_copy)
+#define VEDA_IOC_VMO_WRITE	_IOWR(VEDA_IOCTL, 15, struct veda_vmo_copy)
+#define VEDA_IOC_VMO_MAP	_IOWR(VEDA_IOCTL, 16, struct veda_vmo_map)
+#define VEDA_IOC_BOOTSTRAP	_IOWR(VEDA_IOCTL, 18, struct veda_bootstrap)
+#define VEDA_IOC_CLOCK		_IOWR(VEDA_IOCTL, 19, struct veda_clock)
+#define VEDA_IOC_WATCH		_IOWR(VEDA_IOCTL, 20, struct veda_watch)
+#define VEDA_IOC_VMO_DMABUF	_IOWR(VEDA_IOCTL, 21, struct veda_vmo_dmabuf)
+#define VEDA_IOC_LOG_READ	_IOWR(VEDA_IOCTL, 22, struct veda_log_read)
+
+#endif /* _UAPI_LINUX_VEDA_H */
