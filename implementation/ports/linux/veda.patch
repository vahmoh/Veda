+// SPDX-License-Identifier: GPL-2.0
+/*
+ * The PC's firmware variables, in Veda's driver VM.
+ *
+ * Veda's loader reads the UEFI variables of the PC that an operating
+ * system may read before Veda starts, and the platform gives them to the
+ * guest, read-only, through a hypercall that does what UEFI's GetVariable
+ * and GetNextVariableName do (asm/veda_para.h). Linux reads them as on the
+ * PC: its drivers through EFI's runtime services, of which the platform
+ * has only these (a laptop's speaker amplifiers' driver reads their
+ * calibration so), and programs through efivarfs, read-only.
+ */
+
+#include <linux/efi.h>
+#include <linux/init.h>
+#include <linux/minmax.h>
+#include <linux/overflow.h>
+#include <linux/printk.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+#include <linux/ucs2_string.h>
+#include <asm/veda_para.h>
+
+/*
+ * A request and the buffers it names, in one allocation of the kernel's:
+ * the caller's buffers may be anywhere (on a stack, in a module's data),
+ * the monitor reaches guest-physical memory.
+ */
+struct veda_efi_request {
+	struct veda_variable var;
+	u8 buf[];
+};
+
+static efi_status_t veda_efi_call(unsigned long op, struct veda_efi_request *r)
+{
+	switch (veda_hypercall(VEDA_HC_FIRMWARE_VARIABLE, op, __pa(&r->var), 0, 0, 0)) {
+	case 0:
+		return EFI_SUCCESS;
+	case VEDA_ERR_NOT_FOUND:
+		return EFI_NOT_FOUND;
+	case VEDA_ERR_TOO_SMALL:
+		return EFI_BUFFER_TOO_SMALL;
+	case VEDA_ERR_INVALID:
+		return EFI_INVALID_PARAMETER;
+	default:
+		return EFI_UNSUPPORTED;
+	}
+}
+
+static efi_status_t veda_get_variable(efi_char16_t *name, efi_guid_t *vendor, u32 *attr,
+				      unsigned long *data_size, void *data)
+{
+	struct veda_efi_request *r;
+	efi_status_t status;
+	size_t name_size;
+
+	if (!name || !vendor || !data_size || (*data_size && !data))
+		return EFI_INVALID_PARAMETER;
+	name_size = (ucs2_strnlen(name, EFI_VAR_NAME_LEN) + 1) * sizeof(*name);
+	r = kzalloc(struct_size(r, buf, size_add(name_size, *data_size)), GFP_KERNEL);
+	if (!r)
+		return EFI_OUT_OF_RESOURCES;
+	memcpy(r->var.guid, vendor, sizeof(r->var.guid));
+	memcpy(r->buf, name, name_size - sizeof(*name));
+	r->var.name = __pa(r->buf);
+	r->var.name_size = name_size;
+	r->var.data = __pa(r->buf + name_size);
+	r->var.data_size = *data_size;
+	status = veda_efi_call(VEDA_VARIABLE_GET, r);
+	if (status == EFI_SUCCESS) {
+		*data_size = min_t(u64, r->var.data_size, *data_size);
+		memcpy(data, r->buf + name_size, *data_size);
+	} else if (status == EFI_BUFFER_TOO_SMALL) {
+		*data_size = r->var.data_size;
+	}
+	if (attr && (status == EFI_SUCCESS || status == EFI_BUFFER_TOO_SMALL))
+		*attr = r->var.attributes;
+	kfree(r);
+	return status;
+}
+
+static efi_status_t veda_get_next_variable(unsigned long *name_size, efi_char16_t *name,
+					   efi_guid_t *vendor)
+{
+	struct veda_efi_request *r;
+	efi_status_t status;
+
+	if (!name_size || !name || !vendor)
+		return EFI_INVALID_PARAMETER;
+	r = kzalloc(struct_size(r, buf, *name_size), GFP_KERNEL);
+	if (!r)
+		return EFI_OUT_OF_RESOURCES;
+	memcpy(r->var.guid, vendor, sizeof(r->var.guid));
+	memcpy(r->buf, name, *name_size);
+	r->var.name = __pa(r->buf);
+	r->var.name_size = *name_size;
+	status = veda_efi_call(VEDA_VARIABLE_NEXT, r);
+	if (status == EFI_SUCCESS) {
+		*name_size = min_t(u64, r->var.name_size, *name_size);
+		memcpy(name, r->buf, *name_size);
+		memcpy(vendor, r->var.guid, sizeof(*vendor));
+	} else if (status == EFI_BUFFER_TOO_SMALL) {
+		*name_size = r->var.name_size;
+	}
+	kfree(r);
+	return status;
+}
+
+static struct efivars veda_efivars;
+
+static const struct efivar_operations veda_efivar_ops = {
+	.get_variable		= veda_get_variable,
+	.get_next_variable	= veda_get_next_variable,
+};
+
+/*
+ * After EFI's own setup (efipostcore_init), which finds no runtime services
+ * here, and before the drivers that read variables.
+ */
+static int __init veda_efi_init(void)
+{
+	unsigned long size = sizeof(efi_char16_t);
+	efi_char16_t name = 0;
+	efi_guid_t guid = NULL_GUID;
+
+	if (!veda_platform())
+		return 0;
+	/* With room for no name: the first variable's does not fit, if any. */
+	if (veda_get_next_variable(&size, &name, &guid) != EFI_BUFFER_TOO_SMALL)
+		return 0;
+	efi.get_variable = veda_get_variable;
+	efi.get_next_variable = veda_get_next_variable;
+	efi.runtime_supported_mask = EFI_RT_SUPPORTED_GET_VARIABLE |
+				     EFI_RT_SUPPORTED_GET_NEXT_VARIABLE_NAME;
+	pr_info("veda: the PC's firmware variables, read-only\n");
+	return efivars_register(&veda_efivars, &veda_efivar_ops);
+}
+arch_initcall(veda_efi_init);
